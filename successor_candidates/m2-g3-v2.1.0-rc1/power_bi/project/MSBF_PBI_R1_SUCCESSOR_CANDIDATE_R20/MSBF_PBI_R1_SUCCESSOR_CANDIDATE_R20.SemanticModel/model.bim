              }
            ],
            "displayFolder": "01 Context",
            "expression": [
              "VAR AsOfDate = [Selected As Of Date]",
              "VAR SourceDate = [Source Run As Of Date]",
              "VAR MinEvidence = [Portfolio Evidence Min Date]",
              "VAR MaxEvidence = [Portfolio Evidence Max Date]",
              "RETURN",
              "    SWITCH (",
              "        TRUE (),",
              "        [__Selected As Of Has One Value] = 0 || ISBLANK ( AsOfDate ), \"HOLD_OUTSIDE_EVIDENCE\",",
              "        AsOfDate < SourceDate, \"HOLD_OUTSIDE_EVIDENCE\",",
              "        AsOfDate > MaxEvidence, \"HOLD_OUTSIDE_EVIDENCE\",",
              "        AsOfDate < MinEvidence, \"NOT_YET_OBSERVABLE\",",
              "        \"VALID\"",
              "    )"
            ],
            "formatString": "General",
            "lineageTag": "c2664e7d-1132-5263-aa6f-67f447eac5a9"
          },
          {
            "name": "G2 Contract Pass",
