          {
            "name": "IsEvidenceEndpoint",
            "dataType": "boolean",
            "lineageTag": "ed418b4f-f321-425c-b728-5bc621132754",
            "sourceColumn": "IsEvidenceEndpoint",
            "summarizeBy": "none"
          },
          {
            "name": "IsSourceRunAsOf",
            "dataType": "boolean",
            "lineageTag": "bad1650b-e7eb-41c6-adef-67c8cc06e0fe",
            "sourceColumn": "IsSourceRunAsOf",
            "summarizeBy": "none"
          }
        ],
        "description": "Application, activation, monitoring, event, transition, certification, and review dates.",
        "lineageTag": "2b511f2f-1bb0-496b-b832-138eecfe99a0",
        "partitions": [
          {
            "name": "DimDate",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    SourceDate = Date.From(DimRunCampaign{0}[as_of_date]),",
                "    EvidenceMaxDate = List.Max(stg_msbf_m2_advance_daily_remittance_monitoring[monitoring_date]),",
                "    Dates = List.Dates(SourceDate, Duration.Days(EvidenceMaxDate - SourceDate) + 1, #duration(1,0,0,0)),",
                "    T = Table.FromList(Dates, Splitter.SplitByNothing(), {\"Date\"}, null, ExtraValues.Error),",
                "    Typed = Table.TransformColumnTypes(T, {{\"Date\", type date}}),",
                "    AddYear = Table.AddColumn(Typed, \"Year\", each Date.Year([Date]), Int64.Type),",
                "    AddQuarter = Table.AddColumn(AddYear, \"Quarter\", each \"Q\" & Text.From(Date.QuarterOfYear([Date])), type text),",
                "    AddMonth = Table.AddColumn(AddQuarter, \"MonthNumber\", each Date.Month([Date]), Int64.Type),",
                "    AddMonthName = Table.AddColumn(AddMonth, \"MonthName\", each Date.MonthName([Date]), type text),",
                "    AddMonthYear = Table.AddColumn(AddMonthName, \"MonthYear\", each Date.ToText([Date], \"yyyy-MM\", \"en-US\"), type text),",
                "    AddEndpoint = Table.AddColumn(AddMonthYear, \"IsEvidenceEndpoint\", each [Date] = EvidenceMaxDate, type logical),",
                "    AddSourceDate = Table.AddColumn(AddEndpoint, \"IsSourceRunAsOf\", each [Date] = SourceDate, type logical)",
                "in AddSourceDate"
              ],
              "type": "m"
            }
          }
        ]
      },
      {
        "name": "DimAsOfDate",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          },
          {
            "name": "MSBF_ActivationWave",
            "value": "A1a"
          },
          {
            "name": "MSBF_LocalEngineStatus",
            "value": "PENDING_LOCAL_DESKTOP_EVIDENCE"
          },
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          }
        ],
        "columns": [
          {
            "name": "AsOfDate",
            "annotations": [
              {
                "name": "UnderlyingDateTimeDataType",
                "value": "Date"
              }
            ],
            "dataType": "dateTime",
