            "lineageTag": "4aee8706-9344-4a3c-bab5-b9e9b08fdf66",
            "sourceColumn": "RunScenarioKey",
            "summarizeBy": "none"
          },
          {
            "name": "ScenarioLabel",
            "dataType": "string",
            "lineageTag": "6bf7bdc5-fc9a-4596-a3af-31c989c6e38b",
            "sourceColumn": "ScenarioLabel",
            "summarizeBy": "none"
          }
        ],
        "description": "Prevent mixed-scenario aggregation and retain governed scenario identity.",
        "lineageTag": "bbd6d7cc-3c4f-4bbf-b89b-81f7de74c1bf",
        "partitions": [
          {
            "name": "DimScenario",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Table.Distinct(Table.SelectColumns(stg_msbf_m1_application_module1_latest, {\"module1_run_id\",\"scenario_id\",\"scenario_code\"})),",
                "    AddKey = Table.AddColumn(Source, \"RunScenarioKey\", each fxKeyPart([module1_run_id]) & \"|\" & fxKeyPart([scenario_id]), type text),",
                "    AddLabel = Table.AddColumn(AddKey, \"ScenarioLabel\", each Text.Replace(Text.Proper(Text.Lower([scenario_code])), \"_\", \" \"), type text),",
                "    Sorted = Table.Sort(AddLabel, {{\"scenario_id\", Order.Ascending}})",
                "in Sorted"
              ],
              "type": "m"
            }
          }
        ]
      },
