          {
            "name": "Source Reconciliation Pass",
            "annotations": [
              {
                "name": "MSBF_ActivationWave",
                "value": "A1b"
              },
              {
                "name": "MSBF_LocalEngineStatus",
                "value": "PENDING_A1B_LOCAL_ENGINE_EVIDENCE"
              }
            ],
            "displayFolder": "02 Governance",
            "expression": [
              "VAR ExpectedSourceControls = 214",
              "VAR ExpectedValidationControls = 533",
              "VAR SourceControls = COUNTROWS ( 'FactSourceReconciliation' )",
              "VAR SourceDistinctKeys = DISTINCTCOUNT ( 'FactSourceReconciliation'[SourceObjectKey] )",
              "VAR AcceptedSourceControls =",
              "    CALCULATE (",
              "        COUNTROWS ( 'FactSourceReconciliation' ),",
              "        'FactSourceReconciliation'[object_audit_status] = \"PASS_A1A_R3_STATIC\"",
              "    )",
              "VAR ValidationControls = COUNTROWS ( 'FactValidationResult' )",
              "VAR ValidationDistinctKeys = DISTINCTCOUNT ( 'FactValidationResult'[ValidationControlKey] )",
              "VAR AcceptedValidationControls =",
              "    CALCULATE (",
              "        COUNTROWS ( 'FactValidationResult' ),",
              "        'FactValidationResult'[status] = \"PASS\"",
              "    )",
              "RETURN",
              "    IF (",
              "        SourceControls = ExpectedSourceControls",
              "            && SourceDistinctKeys = ExpectedSourceControls",
              "            && AcceptedSourceControls = ExpectedSourceControls",
              "            && ValidationControls = ExpectedValidationControls",
              "            && ValidationDistinctKeys = ExpectedValidationControls",
              "            && AcceptedValidationControls = ExpectedValidationControls,",
              "        1,",
              "        0",
              "    )"
            ],
            "formatString": "0",
            "lineageTag": "d2745e6a-c9ad-5a24-bd5a-73e586caf1d4"
          },
