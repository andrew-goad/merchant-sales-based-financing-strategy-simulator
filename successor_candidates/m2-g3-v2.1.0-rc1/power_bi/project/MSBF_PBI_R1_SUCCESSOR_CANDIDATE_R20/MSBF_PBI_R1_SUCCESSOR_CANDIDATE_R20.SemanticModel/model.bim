              },
              {
                "name": "MSBF_LocalEngineStatus",
                "value": "PENDING_A1B_LOCAL_ENGINE_EVIDENCE"
              }
            ],
            "displayFolder": "06 Risk & Economics",
            "expression": [
              "CALCULATE (",
              "    DISTINCTCOUNT ( 'FactApplicationScenario'[ApplicationScenarioKey] ),",
              "    'FactApplicationScenario'[risk_adjusted_contribution_amount] < 0",
              ")"
            ],
            "formatString": "#,0",
            "lineageTag": "d09aa2e4-01f6-5192-8fe2-42102da48ea6"
          },
          {
            "name": "Open Servicing Queue",
            "annotations": [
              {
                "name": "MSBF_ActivationWave",
                "value": "A1b"
              },
              {
                "name": "MSBF_LocalEngineStatus",
                "value": "PENDING_A1B_LOCAL_ENGINE_EVIDENCE"
              }
            ],
            "displayFolder": "08 Servicing",
            "expression": [
              "IF (",
              "    [As Of Evidence Status] = \"VALID\",",
              "    IF (",
              "        [Endpoint Evidence Available] = 1,",
              "        CALCULATE (",
              "            DISTINCTCOUNT ( 'FactPortfolioPerformanceEndpoint'[AccountKey] ),",
              "            'FactPortfolioPerformanceEndpoint'[servicing_queue_code] <> \"NO_SERVICING_REQUIRED\"",
              "        ),",
              "        SUMX (",
              "            VALUES ( 'DimAccountAdvance'[AccountKey] ),",
              "            IF (",
              "                CALCULATE ( [__Account Active Alert Count As Of] ) > 0,",
              "                1,",
              "                0",
              "            )",
              "        )",
              "    )",
              ")"
            ],
            "formatString": "#,0",
            "lineageTag": "5dbb171c-0aee-51fe-af38-c40f1bf796ff"
          },
          {
            "name": "Servicing Burden Units",
            "annotations": [
              {
                "name": "MSBF_ActivationWave",
                "value": "A1b"
              },
              {
                "name": "MSBF_LocalEngineStatus",
                "value": "PENDING_A1B_LOCAL_ENGINE_EVIDENCE"
              }
            ],
            "displayFolder": "08 Servicing",
            "expression": [
              "IF (",
              "    [Endpoint Evidence Available] = 1,",
              "    SUM ( 'FactPortfolioPerformanceEndpoint'[servicing_burden_units] )",
              ")"
            ],
            "formatString": "0.0",
            "lineageTag": "fd1ead62-5d94-5799-9f2e-2c6646fcc0e1"
          },
          {
            "name": "Unresolved Payment Exceptions As Of",
            "annotations": [
              {
                "name": "MSBF_ActivationWave",
                "value": "A1b"
              },
              {
                "name": "MSBF_LocalEngineStatus",
                "value": "PENDING_A1B_LOCAL_ENGINE_EVIDENCE"
              }
            ],
            "displayFolder": "08 Servicing",
            "expression": [
              "VAR AsOfDate = [Selected As Of Date]",
              "RETURN",
              "    IF (",
              "        [As Of Evidence Status] = \"VALID\",",
              "        CALCULATE (",
              "            COUNTROWS (",
              "                FILTER (",
              "                    'FactPaymentException',",
              "                    'FactPaymentException'[originating_event_date] <= AsOfDate",
              "                        && (",
              "                            ISBLANK ( 'FactPaymentException'[resolving_event_date] )",
              "                                || 'FactPaymentException'[resolving_event_date] > AsOfDate",
              "                        )",
              "                )",
              "            ),",
              "            REMOVEFILTERS ( 'DimDate' )",
              "        )",
              "    )"
            ],
            "formatString": "#,0",
            "lineageTag": "35827f8c-59a8-5311-b402-76c937f95e8c"
          },
          {
            "name": "Reconciliation Difference",
            "annotations": [
              {
                "name": "MSBF_ActivationWave",
                "value": "A1b"
              },
              {
                "name": "MSBF_LocalEngineStatus",
                "value": "PENDING_A1B_LOCAL_ENGINE_EVIDENCE"
              }
            ],
            "displayFolder": "13 Validation",
            "expression": [
              "VAR LoadedRowsPresent = COUNT ( 'FactSourceReconciliation'[loaded_rows] )",
              "RETURN",
              "    IF (",
              "        LoadedRowsPresent > 0,",
              "        SUM ( 'FactSourceReconciliation'[loaded_rows] )",
              "            - SUM ( 'FactSourceReconciliation'[actual_rows] )",
              "    )"
            ],
            "formatString": "#,0",
            "lineageTag": "a0a981de-336f-5016-a9ee-06baececf25d"
          },
          {
            "name": "Primary Key Fail Count",
            "annotations": [
              {
                "name": "MSBF_ActivationWave",
                "value": "A1b"
              },
              {
                "name": "MSBF_LocalEngineStatus",
                "value": "PENDING_A1B_LOCAL_ENGINE_EVIDENCE"
              }
            ],
            "displayFolder": "13 Validation",
            "expression": [
              "CALCULATE (",
              "    COUNTROWS ( 'FactValidationResult' ),",
              "    'FactValidationResult'[validation_category] = \"PRIMARY_KEY\",",
              "    'FactValidationResult'[status] <> \"PASS\"",
              ")"
            ],
            "formatString": "#,0",
            "lineageTag": "3e83d1c1-df69-5b9d-b5c1-a94c4eb1c234"
          },
          {
            "name": "Orphan Fail Count",
            "annotations": [
              {
                "name": "MSBF_ActivationWave",
                "value": "A1b"
              },
              {
                "name": "MSBF_LocalEngineStatus",
                "value": "PENDING_A1B_LOCAL_ENGINE_EVIDENCE"
              }
            ],
            "displayFolder": "13 Validation",
            "expression": [
              "CALCULATE (",
              "    COUNTROWS ( 'FactValidationResult' ),",
              "    'FactValidationResult'[validation_category] = \"SOURCE_RELATIONSHIP_ORPHAN\",",
              "    'FactValidationResult'[status] <> \"PASS\"",
              ")"
            ],
            "formatString": "#,0",
            "lineageTag": "3792460e-14a1-58c4-ba81-28ce445eaba3"
          },
          {
            "name": "Measure Recompute Fail Count",
            "annotations": [
              {
                "name": "MSBF_ActivationWave",
                "value": "A1b"
              },
              {
                "name": "MSBF_LocalEngineStatus",
                "value": "PENDING_A1B_LOCAL_ENGINE_EVIDENCE"
              }
            ],
            "displayFolder": "13 Validation",
            "expression": [
              "VAR RecomputeControls =",
              "    CALCULATE (",
              "        COUNTROWS ( 'FactValidationResult' ),",
              "        'FactValidationResult'[validation_category] = \"MEASURE_RECOMPUTATION\"",
              "    )",
              "RETURN",
              "    IF (",
              "        RecomputeControls > 0,",
              "        CALCULATE (",
              "            COUNTROWS ( 'FactValidationResult' ),",
              "            'FactValidationResult'[validation_category] = \"MEASURE_RECOMPUTATION\",",
              "            'FactValidationResult'[status] <> \"PASS\"",
              "        )",
              "    )"
            ],
            "formatString": "#,0",
            "lineageTag": "c4e8b8f4-da61-517f-b3e3-02b7d96e1ffb"
          },
          {
            "name": "P01 Run",
            "expression": [
