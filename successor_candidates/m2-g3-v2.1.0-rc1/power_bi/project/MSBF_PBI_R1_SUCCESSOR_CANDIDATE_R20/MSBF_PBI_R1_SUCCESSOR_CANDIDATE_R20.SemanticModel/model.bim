          {
            "name": "P04 Monitoring Status",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "changedProperties": [
              {
                "property": "SortByColumn"
              }
            ],
            "dataType": "string",
            "expression": [
              "",
              "SWITCH (",
              "    FactMonitoringEndpoint[latest_monitoring_status_code],",
              "    \"PAID_OFF\", \"Paid off\",",
              "    \"CURRENT\", \"Current\",",
              "    \"WATCH\", \"Watch\",",
              "    \"UNDERPERFORMING\", \"Underperforming\",",
              "    \"SEVERE_SHORTFALL\", \"Severe shortfall\",",
              "    SUBSTITUTE (",
              "        FactMonitoringEndpoint[latest_monitoring_status_code],",
              "        \"_\",",
              "        \" \"",
              "    )",
              ")"
            ],
            "isDataTypeInferred": true,
            "lineageTag": "bdd5e5f7-5566-4cfa-a64f-15710f7d1985",
            "sortByColumn": "P04 Monitoring Status Sort",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "P04 Monitoring Status Sort",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "int64",
            "expression": [
              "",
              "SWITCH (",
              "    FactMonitoringEndpoint[latest_monitoring_status_code],",
              "    \"SEVERE_SHORTFALL\", 1,",
              "    \"UNDERPERFORMING\", 2,",
              "    \"WATCH\", 3,",
              "    \"CURRENT\", 4,",
              "    \"PAID_OFF\", 5,",
              "    99",
              ")"
            ],
            "formatString": "0",
            "isDataTypeInferred": true,
            "lineageTag": "07a5c57b-41a8-4fde-93ed-7ac3f6907a10",
            "summarizeBy": "sum",
            "type": "calculated"
          },
          {
            "name": "P04 Merchant",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string",
            "expression": [
              "",
              "VAR _Merchant = FactMonitoringEndpoint[merchant_id]",
              "VAR _Pos = SEARCH ( \"M\", _Merchant, 1, BLANK() )",
              "RETURN",
              "    IF (",
              "        NOT ISBLANK ( _Pos ),",
              "        RIGHT ( _Merchant, 6 ),",
              "        _Merchant",
              "    )"
            ],
            "isDataTypeInferred": true,
            "lineageTag": "fe2557de-0b2d-4d77-b1ab-1b9ec9c7ba13",
            "summarizeBy": "none",
            "type": "calculated"
          }
        ],
        "description": "Accepted monitoring endpoint.",
        "lineageTag": "0ac783d4-b6aa-5a01-b4ca-ed8fb89f5788",
        "partitions": [
          {
            "name": "FactMonitoringEndpoint",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = stg_msbf_m2_advance_portfolio_monitoring_latest,",
                "    AddApplicationKey = Table.AddColumn(Source, \"ApplicationKey\", each fxKeyPart([module1_run_id]) & \"|\" & fxKeyPart([merchant_application_id]), type text),",
                "    AddRunScenarioKey = Table.AddColumn(AddApplicationKey, \"RunScenarioKey\", each fxKeyPart([module1_run_id]) & \"|\" & fxKeyPart([scenario_id]), type text),",
                "    AddApplicationScenarioKey = Table.AddColumn(AddRunScenarioKey, \"ApplicationScenarioKey\", each fxKeyPart([module1_run_id]) & \"|\" & fxKeyPart([scenario_id]) & \"|\" & fxKeyPart([merchant_application_id]), type text),",
                "    AddAccountKey = Table.AddColumn(AddApplicationScenarioKey, \"AccountKey\", each fxKeyPart([module1_run_id]) & \"|\" & fxKeyPart([scenario_id]) & \"|\" & fxKeyPart([merchant_application_id]), type text)",
                "in",
                "    AddAccountKey"
              ],
              "type": "m"
            }
          }
        ]
