            "displayFolder": "02 Governance",
            "expression": [
              "IF (",
              "    CALCULATE (",
              "        COUNTROWS ( 'FactGovernanceControl' ),",
              "        'FactGovernanceControl'[ControlCode] = \"G2_M1_CONTRACT\",",
              "        'FactGovernanceControl'[ResultStatus] = \"PASS\"",
              "    ) = 1,",
              "    1,",
              "    0",
              ")"
            ],
            "formatString": "0",
