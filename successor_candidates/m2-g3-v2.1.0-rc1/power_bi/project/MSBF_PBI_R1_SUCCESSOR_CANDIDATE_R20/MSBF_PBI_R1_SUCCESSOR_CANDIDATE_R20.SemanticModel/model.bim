          },
          {
            "name": "P04 Exception Status",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string",
            "expression": [
              "",
              "SWITCH (",
              "    FactPaymentException[exception_status_code],",
              "    \"RESOLVED_BY_RETRY\", \"Resolved by retry\",",
              "    SUBSTITUTE (",
              "        FactPaymentException[exception_status_code],",
              "        \"_\",",
              "        \" \"",
              "    )",
              ")"
            ],
            "isDataTypeInferred": true,
            "lineageTag": "59b88db5-eebb-46ce-9524-a8617b77c83a",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "P04 Exception Resolution",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string",
            "expression": [
              "",
              "SWITCH (",
              "    FactPaymentException[resolution_action_code],",
              "    \"RESOLVE_RETURN_WITH_RETRY\", \"Return resolved by retry\",",
              "    SUBSTITUTE (",
              "        FactPaymentException[resolution_action_code],",
              "        \"_\",",
              "        \" \"",
              "    )",
              ")"
            ],
            "isDataTypeInferred": true,
            "lineageTag": "93c02009-8914-4988-94d0-31aacfc204a7",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "P04 Exception Merchant",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string",
            "expression": [
              "",
              "VAR _Application =",
              "    FactPaymentException[merchant_application_id]",
              "VAR _MerchantStart =",
              "    SEARCH ( \"_M\", _Application, 1, BLANK () )",
              "RETURN",
              "    IF (",
              "        NOT ISBLANK ( _MerchantStart ),",
              "        MID ( _Application, _MerchantStart + 2, 6 ),",
              "        _Application",
              "    )"
            ],
            "isDataTypeInferred": true,
            "lineageTag": "65ebe270-bfc9-4b47-a2eb-5449dca25c0a",
            "summarizeBy": "none",
            "type": "calculated"
          }
        ],
        "description": "Open/resolved exception evidence.",
        "lineageTag": "88a99644-8d77-58c4-b97b-2736de85d733",
        "partitions": [
          {
            "name": "FactPaymentException",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = stg_msbf_m2_payment_exception_case_snapshot,",
                "    AddApplicationKey = Table.AddColumn(Source, \"ApplicationKey\", each fxKeyPart([module1_run_id]) & \"|\" & fxKeyPart([merchant_application_id]), type text),",
                "    AddRunScenarioKey = Table.AddColumn(AddApplicationKey, \"RunScenarioKey\", each fxKeyPart([module1_run_id]) & \"|\" & fxKeyPart([scenario_id]), type text),",
                "    AddApplicationScenarioKey = Table.AddColumn(AddRunScenarioKey, \"ApplicationScenarioKey\", each fxKeyPart([module1_run_id]) & \"|\" & fxKeyPart([scenario_id]) & \"|\" & fxKeyPart([merchant_application_id]), type text),",
                "    AddAccountKey = Table.AddColumn(AddApplicationScenarioKey, \"AccountKey\", each fxKeyPart([module1_run_id]) & \"|\" & fxKeyPart([scenario_id]) & \"|\" & fxKeyPart([merchant_application_id]), type text),",
                "    AddFactKey = Table.AddColumn(AddAccountKey, \"PaymentExceptionKey\", each [AccountKey] & \"|\" & fxKeyPart([synthetic_exception_case_id]), type text)",
                "in",
                "    AddFactKey"
              ],
              "type": "m"
            }
          }
        ]
      },
