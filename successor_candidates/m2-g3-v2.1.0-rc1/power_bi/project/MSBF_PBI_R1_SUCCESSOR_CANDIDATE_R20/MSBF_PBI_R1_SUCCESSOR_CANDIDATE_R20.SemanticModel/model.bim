          {
            "name": "R1FactApplicationStrategySimulation",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = fxReadSuccessorCsv(\"R1FactApplicationStrategySimulation\"),",
                "    Typed = Table.TransformColumnTypes(Source, {",
                "            {\"module1_run_id\", Int64.Type},\n            {\"scenario_id\", Int64.Type},\n            {\"scenario_code\", type text},\n            {\"merchant_application_id\", type text},\n            {\"merchant_id\", type text},\n            {\"strategy_profile_code\", type text},\n            {\"profile_sequence\", Int64.Type},\n            {\"source_final_outcome_code\", type text},\n            {\"source_selected_candidate_id\", type text},\n            {\"strategy_outcome_code\", type text},\n            {\"selected_candidate_id\", type text},\n            {\"selected_feasibility_class\", type text},\n            {\"selected_funding_amount\", type number},\n            {\"selected_finance_charge_amount\", type number},\n            {\"selected_expected_loss_amount\", type number},\n            {\"selected_loss_density\", type number},\n            {\"selected_risk_adjusted_contribution\", type number},\n            {\"selected_annualized_return\", type number},\n            {\"selected_payment_burden_rate\", type number},\n            {\"source_search_required_flag\", type text},\n            {\"source_search_complete_flag\", type text},\n            {\"source_no_feasible_proof_flag\", type text},\n            {\"funded_source_flag\", type text},\n            {\"m2_7_joined_flag\", type text},\n            {\"m2_10_joined_flag\", type text},\n            {\"operational_setup_outcome_code\", type text},\n            {\"portfolio_performance_tier_code\", type text},\n            {\"simulation_authority_state\", type text},\n            {\"source_root_sha256\", type text},\n            {\"row_hash\", type text},\n            {\"industry_code\", type text},\n            {\"population_id\", type text},\n            {\"merchant_size_tier\", type text},\n            {\"relationship_stage\", type text},\n            {\"channel_type\", type text},\n            {\"ApplicationKey\", type text},\n            {\"RunScenarioKey\", type text},\n            {\"ApplicationScenarioKey\", type text},\n            {\"StrategyProfileKey\", type text},\n            {\"ApplicationScenarioProfileKey\", type text},\n            {\"R1SourceBoundary\", type text},\n            {\"R1SourceArtifactSha256\", type text},\n            {\"R1AuthorityState\", type text}",
                "    }, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "annotations": [
