            "value": "A1a"
          },
          {
            "name": "MSBF_LocalEngineStatus",
            "value": "PENDING_LOCAL_DESKTOP_EVIDENCE"
          }
        ],
        "columns": [
          {
            "name": "ParameterCode",
            "dataType": "string",
            "lineageTag": "71d972e6-a9ce-468a-9fa4-3d9e5b971cfd",
            "sourceColumn": "ParameterCode",
            "summarizeBy": "none"
          },
          {
            "name": "ParameterValue",
            "dataType": "string",
            "lineageTag": "0a088ef4-9ad2-4a66-9e71-7b3566a62c8d",
            "sourceColumn": "ParameterValue",
            "summarizeBy": "none"
          }
        ],
        "description": "Expose model/source/recommendation versions and current parameter values to governance measures.",
        "isHidden": true,
        "lineageTag": "40010bb8-9207-4fc8-b458-ea2bb978d358",
        "measures": [
          {
            "name": "__Selected As Of Has One Value",
            "annotations": [
              {
                "name": "MSBF_ActivationWave",
                "value": "A1b"
              },
              {
                "name": "MSBF_LocalEngineStatus",
                "value": "PENDING_A1B_LOCAL_ENGINE_EVIDENCE"
              }
            ],
            "description": "Single-selection guard for the disconnected as-of controller.",
            "displayFolder": "99 Helpers\\Context",
            "expression": [
              "IF (",
              "    NOT ISFILTERED ( 'DimAsOfDate'[AsOfDate] )",
              "        || HASONEVALUE ( 'DimAsOfDate'[AsOfDate] ),",
              "    1,",
              "    0",
              ")"
            ],
            "formatString": "0",
            "isHidden": true,
            "lineageTag": "3e8aa316-53b6-5a09-bc5c-c3e7a9056c1e"
          },
          {
            "name": "__Scenario Context Pass",
            "annotations": [
              {
                "name": "MSBF_ActivationWave",
                "value": "A1b"
              },
              {
                "name": "MSBF_LocalEngineStatus",
                "value": "PENDING_A1B_LOCAL_ENGINE_EVIDENCE"
              }
            ],
            "description": "Recommendation pages require exactly one scenario path.",
            "displayFolder": "99 Helpers\\Context",
            "expression": "IF ( HASONEVALUE ( 'DimScenario'[RunScenarioKey] ), 1, 0 )",
            "formatString": "0",
            "isHidden": true,
            "lineageTag": "c3a50dfa-3dac-5154-820f-15f299c52615"
          },
          {
            "name": "__Account Latest Monitoring Date As Of",
            "annotations": [
              {
                "name": "MSBF_ActivationWave",
                "value": "A1b"
              },
              {
                "name": "MSBF_LocalEngineStatus",
                "value": "PENDING_A1B_LOCAL_ENGINE_EVIDENCE"
              }
            ],
            "description": "Latest accepted daily evidence date for the current AccountKey on or before the selected as-of.",
            "displayFolder": "99 Helpers\\As Of",
            "expression": [
              "VAR AsOfDate = [Selected As Of Date]",
              "VAR EvidenceStatus = [As Of Evidence Status]",
              "RETURN",
              "    IF (",
              "        EvidenceStatus = \"VALID\"",
              "            && NOT ISBLANK ( SELECTEDVALUE ( 'DimAccountAdvance'[AccountKey] ) ),",
              "        CALCULATE (",
              "            MAX ( 'FactAccountDaily'[monitoring_date] ),",
              "            REMOVEFILTERS ( 'DimDate' ),",
              "            FILTER (",
              "                ALL ( 'FactAccountDaily'[monitoring_date] ),",
              "                'FactAccountDaily'[monitoring_date] <= AsOfDate",
              "            )",
              "        )",
              "    )"
            ],
            "formatString": "yyyy-mm-dd",
            "isHidden": true,
            "lineageTag": "9d5e07cd-5623-5be4-a38e-3770f3b7d0e3"
          },
          {
            "name": "__Account Observable Flag As Of",
            "annotations": [
              {
                "name": "MSBF_ActivationWave",
                "value": "A1b"
              },
              {
                "name": "MSBF_LocalEngineStatus",
                "value": "PENDING_A1B_LOCAL_ENGINE_EVIDENCE"
              }
            ],
            "displayFolder": "99 Helpers\\As Of",
            "expression": "IF ( NOT ISBLANK ( [__Account Latest Monitoring Date As Of] ), 1, 0 )",
            "formatString": "0",
            "isHidden": true,
            "lineageTag": "6b359aab-d39d-5625-be8f-0ade46130e31"
          },
          {
            "name": "__Account Exposure As Of",
            "annotations": [
              {
                "name": "MSBF_ActivationWave",
                "value": "A1b"
              },
              {
                "name": "MSBF_LocalEngineStatus",
                "value": "PENDING_A1B_LOCAL_ENGINE_EVIDENCE"
              }
            ],
            "displayFolder": "99 Helpers\\As Of",
            "expression": [
              "VAR LatestDate = [__Account Latest Monitoring Date As Of]",
              "RETURN",
              "    IF (",
              "        NOT ISBLANK ( LatestDate ),",
              "        CALCULATE (",
              "            MAX ( 'FactAccountDaily'[receivable_balance_after] ),",
              "            REMOVEFILTERS ( 'DimDate' ),",
              "            FILTER (",
              "                ALL ( 'FactAccountDaily'[monitoring_date] ),",
              "                'FactAccountDaily'[monitoring_date] = LatestDate",
              "            )",
              "        )",
              "    )"
            ],
            "formatString": "$#,0.00",
            "isHidden": true,
            "lineageTag": "e966fdf6-3b49-56fa-812b-73ad7972fa30"
          },
          {
            "name": "__Account Cumulative Actual As Of",
            "annotations": [
              {
                "name": "MSBF_ActivationWave",
                "value": "A1b"
              },
              {
                "name": "MSBF_LocalEngineStatus",
                "value": "PENDING_A1B_LOCAL_ENGINE_EVIDENCE"
              }
            ],
            "displayFolder": "99 Helpers\\As Of",
            "expression": [
              "VAR LatestDate = [__Account Latest Monitoring Date As Of]",
              "RETURN",
              "    IF (",
              "        NOT ISBLANK ( LatestDate ),",
              "        CALCULATE (",
              "            MAX ( 'FactAccountDaily'[cumulative_remittance_amount] ),",
              "            REMOVEFILTERS ( 'DimDate' ),",
              "            FILTER (",
              "                ALL ( 'FactAccountDaily'[monitoring_date] ),",
              "                'FactAccountDaily'[monitoring_date] = LatestDate",
              "            )",
              "        )",
              "    )"
            ],
            "formatString": "$#,0.00",
            "isHidden": true,
            "lineageTag": "d19701c0-2a4c-5a2b-83c2-a6b09361e1ea"
          },
          {
            "name": "__Account Cumulative Expected As Of",
            "annotations": [
              {
                "name": "MSBF_ActivationWave",
                "value": "A1b"
              },
              {
                "name": "MSBF_LocalEngineStatus",
                "value": "PENDING_A1B_LOCAL_ENGINE_EVIDENCE"
