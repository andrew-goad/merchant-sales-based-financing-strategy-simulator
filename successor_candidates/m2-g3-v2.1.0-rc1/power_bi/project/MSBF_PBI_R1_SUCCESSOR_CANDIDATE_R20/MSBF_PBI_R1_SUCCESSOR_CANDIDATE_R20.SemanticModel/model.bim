        "description": "Catalog/source/load count, hash, header, and status reconciliation.",
        "isHidden": true,
        "lineageTag": "65b80dfe-49cc-49b7-8fb6-8fee4882b299",
        "partitions": [
          {
            "name": "FactSourceReconciliation",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = fxReadBuildCsv(\"catalogs/SOURCE_OBJECT_PROFILE.csv\"),",
                "    Typed = Table.TransformColumnTypes(Source, {{\"schema\",type text},{\"object\",type text},{\"catalog_rows\",Int64.Type},{\"actual_rows\",Int64.Type},{\"catalog_columns\",Int64.Type},{\"actual_columns\",Int64.Type},{\"catalog_bytes\",Int64.Type},{\"actual_bytes\",Int64.Type},{\"object_audit_status\",type text}}, \"en-US\"),",
                "    AddKey = Table.AddColumn(Typed, \"SourceObjectKey\", each [schema] & \".\" & [object], type text),",
                "    AddLoadedPlaceholder = Table.AddColumn(AddKey, \"loaded_rows\", each null, Int64.Type),",
                "    AddNote = Table.AddColumn(AddLoadedPlaceholder, \"loaded_reconciliation_status\", each \"PENDING_DESKTOP_REFRESH_EVIDENCE\", type text)",
                "in AddNote"
              ],
              "type": "m"
            }
          }
        ]
      },
