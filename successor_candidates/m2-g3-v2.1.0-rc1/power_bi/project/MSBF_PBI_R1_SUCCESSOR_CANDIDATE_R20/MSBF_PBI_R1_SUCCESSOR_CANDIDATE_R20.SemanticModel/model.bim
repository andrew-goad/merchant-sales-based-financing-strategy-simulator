          {
            "name": "P03 Application Label",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string",
            "expression": [
              "",
              "VAR _Application = 'DimApplication'[merchant_application_id]",
              "VAR _Marker = SEARCH ( \"_A\", _Application, 1, 0 )",
              "RETURN",
              "    IF (",
              "        ISBLANK ( _Application ) || _Marker = 0,",
              "        BLANK (),",
              "        MID (",
              "            _Application,",
              "            _Marker + 1,",
              "            LEN ( _Application )",
              "        )",
              "    )"
            ],
            "isDataTypeInferred": true,
            "lineageTag": "ef70b34f-8fcd-4920-a20c-4c0dc3341ecc",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "P03 Use Label",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string",
            "expression": [
              "",
              "VAR _Value = 'DimApplication'[requested_use_of_proceeds]",
              "RETURN",
              "    SWITCH (",
              "        _Value,",
              "        \"WORKING_CAPITAL\", \"Working capital\",",
              "        \"INVENTORY\", \"Inventory\",",
              "        \"SEASONAL_NEED\", \"Seasonal need\",",
              "        \"EXPANSION\", \"Expansion\",",
              "        \"EQUIPMENT\", \"Equipment\",",
              "        IF (",
              "            ISBLANK ( _Value ),",
              "            BLANK (),",
              "            SUBSTITUTE ( _Value, \"_\", \" \" )",
              "        )",
              "    )"
            ],
            "isDataTypeInferred": true,
            "lineageTag": "d5af1727-37f3-43f1-b457-a58cff42e5e0",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "P03 Channel Label",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string",
            "expression": [
              "",
              "VAR _Value = 'DimApplication'[application_channel]",
              "RETURN",
              "    SWITCH (",
              "        _Value,",
              "        \"PROCESSOR_EMBEDDED\", \"Processor embedded\",",
              "        \"DIGITAL_DIRECT\", \"Digital direct\",",
              "        \"BROKER_REFERRAL\", \"Broker referral\",",
              "        IF (",
              "            ISBLANK ( _Value ),",
              "            BLANK (),",
              "            SUBSTITUTE ( _Value, \"_\", \" \" )",
              "        )",
              "    )"
            ],
            "isDataTypeInferred": true,
            "lineageTag": "2a9bc815-ed11-42fc-9740-5c7a3e93f295",
            "summarizeBy": "none",
            "type": "calculated"
          }
        ],
        "description": "Application identity, merchant relationship, application date/channel, acquisition source/campaign.",
        "lineageTag": "90f05700-f39e-40ab-867d-43967e99a297",
        "partitions": [
          {
            "name": "DimApplication",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Application = stg_msbf_m1_merchant_application,",
                "    AcquisitionKeep = Table.SelectColumns(stg_msbf_m1_application_acquisition_contract_latest, {\"merchant_application_id\",\"primary_source_code\",\"primary_campaign_id\",\"accepted_partner_channel_id\",\"accepted_channel_type\",\"accepted_application_channel\",\"attribution_method_code\",\"attribution_confidence_score\",\"attribution_confidence_tier\",\"attribution_evidence_status\"}),",
                "    JoinAcquisition = Table.NestedJoin(Application, {\"merchant_application_id\"}, AcquisitionKeep, {\"merchant_application_id\"}, \"Acquisition\", JoinKind.LeftOuter),",
                "    ExpandAcquisition = Table.ExpandTableColumn(JoinAcquisition, \"Acquisition\", List.RemoveItems(Table.ColumnNames(AcquisitionKeep), {\"merchant_application_id\"}), List.RemoveItems(Table.ColumnNames(AcquisitionKeep), {\"merchant_application_id\"})),",
                "    AddApplicationKey = Table.AddColumn(ExpandAcquisition, \"ApplicationKey\", each fxKeyPart([created_by_run_id]) & \"|\" & fxKeyPart([merchant_application_id]), type text),",
                "    AddMerchantKey = Table.AddColumn(AddApplicationKey, \"MerchantKey\", each fxKeyPart([created_by_run_id]) & \"|\" & fxKeyPart([merchant_id]), type text)",
                "in AddMerchantKey"
              ],
              "type": "m"
            }
          }
        ]
      },
