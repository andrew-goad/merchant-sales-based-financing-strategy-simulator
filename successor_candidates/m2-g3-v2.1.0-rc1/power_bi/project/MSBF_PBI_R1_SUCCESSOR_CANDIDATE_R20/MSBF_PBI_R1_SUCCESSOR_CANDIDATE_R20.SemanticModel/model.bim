            "expression": [
              "IF (",
              "    CALCULATE (",
              "        COUNTROWS ( 'FactGovernanceControl' ),",
              "        'FactGovernanceControl'[ControlCode] = \"G3_M2_CONTRACT\",",
              "        'FactGovernanceControl'[ResultStatus] = \"PASS\"",
              "    ) = 1,",
              "    1,",
              "    0",
              ")"
            ],
            "formatString": "0",
