        ],
        "description": "Synthetic booking/funding/activation evidence.",
        "isHidden": true,
        "lineageTag": "60576e7b-2265-55c2-a304-2d51ddf163c5",
        "partitions": [
          {
            "name": "FactBookingActivation",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = stg_msbf_m2_application_booking_funding_activation_latest,",
                "    AddApplicationKey = Table.AddColumn(Source, \"ApplicationKey\", each fxKeyPart([module1_run_id]) & \"|\" & fxKeyPart([merchant_application_id]), type text),",
                "    AddRunScenarioKey = Table.AddColumn(AddApplicationKey, \"RunScenarioKey\", each fxKeyPart([module1_run_id]) & \"|\" & fxKeyPart([scenario_id]), type text),",
                "    AddApplicationScenarioKey = Table.AddColumn(AddRunScenarioKey, \"ApplicationScenarioKey\", each fxKeyPart([module1_run_id]) & \"|\" & fxKeyPart([scenario_id]) & \"|\" & fxKeyPart([merchant_application_id]), type text),",
                "    AddNullableAccountKey = Table.AddColumn(AddApplicationScenarioKey, \"AccountKey\", each if [synthetic_account_id] = null then null else [ApplicationScenarioKey], type nullable text)",
                "in",
                "    AddNullableAccountKey"
              ],
              "type": "m"
            }
          }
        ]
      },
