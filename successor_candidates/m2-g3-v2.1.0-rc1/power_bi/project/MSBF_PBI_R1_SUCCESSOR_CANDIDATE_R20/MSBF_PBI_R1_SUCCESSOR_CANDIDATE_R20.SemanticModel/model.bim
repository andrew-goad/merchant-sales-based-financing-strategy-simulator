          },
          {
            "name": "P03 Decision Color",
            "displayFolder": "05 Decision",
            "expression": [
              "",
              "VAR _Decision =",
              "    [P03 Decision Display]",
              "RETURN",
              "    SWITCH (",
              "        _Decision,",
              "        \"APPROVED\", \"#2E7D32\",",
              "        \"REVIEW\", \"#B8860B\",",
              "        \"DECLINED\", \"#C62828\",",
              "        \"#6B7280\"",
              "    )"
            ],
            "lineageTag": "f0a6760d-4684-4441-81c3-f4299f3f879a"
          },
          {
            "name": "P04 Accounts Requiring Attention",
            "displayFolder": "08 Servicing",
            "expression": [
              "",
              "COALESCE (",
              "    CALCULATE (",
