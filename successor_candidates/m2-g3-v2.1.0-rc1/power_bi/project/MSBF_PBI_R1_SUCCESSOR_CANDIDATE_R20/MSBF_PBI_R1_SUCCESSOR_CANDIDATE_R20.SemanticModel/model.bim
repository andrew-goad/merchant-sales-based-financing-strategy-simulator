          {
            "name": "created_at",
            "dataType": "dateTime",
            "formatString": "Short Date",
            "lineageTag": "49978150-3b92-5d4c-8dc4-76dccaec3d15",
            "sourceColumn": "created_at",
            "summarizeBy": "none"
          },
          {
            "name": "P01 Executive Outcome Label",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "changedProperties": [
              {
                "property": "SortByColumn"
              }
            ],
            "dataType": "string",
            "expression": [
              "",
              "SWITCH (",
              "    'DimDecisionOutcome'[final_decision_outcome_code],",
              "    \"FINAL_OFFER_AUTHORIZED\", \"Final offer\",",
              "    \"COUNTEROFFER_REVIEW_REQUIRED\", \"Counteroffer review\",",
              "    \"DECLINE_INSUFFICIENT_EVIDENCE_AUTHORIZED\", \"Evidence decline\",",
              "    \"DECLINE_POLICY_AUTHORIZED\", \"Policy decline\",",
              "    'DimDecisionOutcome'[final_decision_outcome_code]",
              ")"
            ],
            "isDataTypeInferred": true,
            "lineageTag": "7daab187-a389-409e-b5db-658552b2c8d9",
            "sortByColumn": "final_decision_outcome_rank",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "P03 Decision Label",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string",
            "expression": [
              "",
              "VAR _Value =",
              "    'DimDecisionOutcome'[final_decision_outcome_code]",
              "RETURN",
              "    SWITCH (",
              "        _Value,",
              "        \"FINAL_OFFER_AUTHORIZED\", \"Final offer\",",
              "        \"COUNTEROFFER_REVIEW_REQUIRED\", \"Counteroffer review\",",
              "        \"DECLINE_POLICY_AUTHORIZED\", \"Policy decline\",",
              "        \"DECLINE_INSUFFICIENT_EVIDENCE_AUTHORIZED\", \"Evidence decline\",",
              "        IF (",
              "            ISBLANK ( _Value ),",
              "            BLANK (),",
              "            SUBSTITUTE ( _Value, \"_\", \" \" )",
              "        )",
              "    )"
            ],
            "isDataTypeInferred": true,
            "lineageTag": "f783fe0f-9637-405d-bfae-fb644425ee87",
            "summarizeBy": "none",
            "type": "calculated"
          }
        ],
        "description": "Final synthetic decision outcomes and ordering.",
        "lineageTag": "7a842de6-eb20-5e66-807a-d1283cc52dda",
        "partitions": [
          {
            "name": "DimDecisionOutcome",
            "mode": "import",
            "source": {
              "expression": "let Source=stg_msbf_m2_final_decision_outcome_definition, Renamed=Table.RenameColumns(Source,{{\"decision_outcome_code\",\"final_decision_outcome_code\"},{\"decision_outcome_rank\",\"final_decision_outcome_rank\"}}) in Renamed",
              "type": "m"
            }
          }
        ]
      },
