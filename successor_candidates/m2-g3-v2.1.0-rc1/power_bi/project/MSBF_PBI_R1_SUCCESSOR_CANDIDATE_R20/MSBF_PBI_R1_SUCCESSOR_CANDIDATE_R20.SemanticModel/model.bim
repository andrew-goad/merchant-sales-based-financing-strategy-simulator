            "displayFolder": "03 Portfolio",
            "expression": [
              "SUMX (",
              "    VALUES ( 'DimAccountAdvance'[AccountKey] ),",
              "    VAR Observable = CALCULATE ( [__Account Observable Flag As Of] )",
              "    VAR Exposure = CALCULATE ( [__Account Exposure As Of] )",
              "    RETURN IF ( Observable = 1 && Exposure > 0, 1, 0 )",
              ")"
