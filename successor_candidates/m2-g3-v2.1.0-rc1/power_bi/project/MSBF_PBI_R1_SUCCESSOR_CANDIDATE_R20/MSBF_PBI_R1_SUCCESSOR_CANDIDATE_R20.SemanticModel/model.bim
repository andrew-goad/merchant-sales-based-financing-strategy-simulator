          {
            "name": "GovernanceControlKey",
            "dataType": "string",
            "isKey": true,
            "lineageTag": "f52959a2-1f35-44c9-aeb2-c548e22a4b3d",
            "sourceColumn": "GovernanceControlKey",
            "summarizeBy": "none"
          }
        ],
        "description": "Contract and acceptance status.",
        "lineageTag": "89bac82d-edf1-47dc-9a7e-71d165860bfa",
        "partitions": [
          {
            "name": "FactGovernanceControl",
            "mode": "import",
            "source": {
              "expression": [
                "// A1a IA-F-002 control: lifecycle status is derived only from authoritative fields, never narrative notes.",
                "let",
                "    RunRow = DimRunCampaign{0},",
                "    RunStatus = Text.Upper(Text.From(RunRow[run_status])),",
                "    G2GateCandidates = Table.SelectRows(stg_msbf_ctl_acceptance_gate_result, each [gate_id] = \"G2_M1_CONTRACT\"),",
                "    G3GateCandidates = Table.SelectRows(stg_msbf_ctl_acceptance_gate_result, each [gate_id] = \"G3_M2_CONTRACT\"),",
                "    G2Gate = if Table.RowCount(G2GateCandidates) = 0 then error Error.Record(\"G2_GATE_MISSING\", \"No accepted-run G2 gate result was found.\", []) else Table.First(Table.Sort(G2GateCandidates, {{\"review_version\", Order.Descending}})),",
                "    G3Gate = if Table.RowCount(G3GateCandidates) = 0 then error Error.Record(\"G3_GATE_MISSING\", \"No accepted-run G3 gate result was found.\", []) else Table.First(Table.Sort(G3GateCandidates, {{\"review_version\", Order.Descending}})),",
                "    G2Registry = stg_msbf_ctl_m1_17_g2_bundle_registry{0},",
                "    G3Latest = stg_msbf_ctl_m2_12_g3_bundle_latest{0},",
                "    G3Registry = stg_msbf_ctl_m2_12_g3_bundle_registry{0},",
                "    G2GateStatus = Text.Upper(Text.From(G2Gate[result_status])),",
                "    G3GateStatus = Text.Upper(Text.From(G3Gate[result_status])),",
                "    G2RegistryStatus = Text.Upper(Text.From(G2Registry[bundle_status])),",
                "    G3RegistryStatus = Text.Upper(Text.From(G3Registry[contract_status])),",
                "    LifecycleAccepted = RunStatus = \"M2_12_ACCEPTED\",",
                "    G2Accepted = LifecycleAccepted and G2GateStatus = \"PASS\" and (Text.Contains(G2RegistryStatus, \"ACCEPT\") or G2RegistryStatus = \"PASS\"),",
                "    G3Accepted = LifecycleAccepted and G3GateStatus = \"PASS\" and (Text.Contains(G3RegistryStatus, \"ACCEPT\") or G3RegistryStatus = \"PASS\"),",
                "    Rows = {",
                "        [ControlCode=\"RUN_LIFECYCLE_AUTHORITY\", ResultStatus=if LifecycleAccepted then \"PASS\" else \"FAIL\", ObservedValue=RunStatus, ExpectedValue=\"M2_12_ACCEPTED\", ControlClass=\"LIFECYCLE\", Boundary=\"Lifecycle derives from run_registry.run_status; narrative metadata is excluded.\", StatusAuthority=\"msbf_ctl.run_registry.run_status\", NotesUsedForStatus=false],",
                "        [ControlCode=\"G2_M1_CONTRACT\", ResultStatus=if G2Accepted then \"PASS\" else \"FAIL\", ObservedValue=\"run_status=\" & RunStatus & \"|gate=\" & G2GateStatus & \"|registry=\" & G2RegistryStatus & \"|hash=\" & Text.From(G2Registry[combined_g2_hash]), ExpectedValue=\"M2_12_ACCEPTED|PASS|ACCEPTED\", ControlClass=\"ACCEPTANCE\", Boundary=\"Accepted synthetic Module 1 consumption boundary.\", StatusAuthority=\"run_registry.run_status + acceptance_gate_result.result_status + m1_17_g2_bundle_registry.bundle_status\", NotesUsedForStatus=false],",
                "        [ControlCode=\"G3_M2_CONTRACT\", ResultStatus=if G3Accepted then \"PASS\" else \"FAIL\", ObservedValue=\"run_status=\" & RunStatus & \"|gate=\" & G3GateStatus & \"|registry=\" & G3RegistryStatus & \"|hash=\" & Text.From(G3Registry[combined_set_hash]), ExpectedValue=\"M2_12_ACCEPTED|PASS|ACCEPTED\", ControlClass=\"ACCEPTANCE\", Boundary=\"Accepted synthetic Module 2 enterprise-consumption boundary.\", StatusAuthority=\"run_registry.run_status + acceptance_gate_result.result_status + m2_12_g3_bundle_registry.contract_status\", NotesUsedForStatus=false],",
                "        [ControlCode=\"SYNTHETIC_DATA_ONLY\", ResultStatus=if G3Latest[synthetic_data_only_flag] then \"PASS\" else \"FAIL\", ObservedValue=Text.From(G3Latest[synthetic_data_only_flag]), ExpectedValue=\"true\", ControlClass=\"BOUNDARY\", Boundary=\"All supplied data are deterministic and synthetic.\", StatusAuthority=\"m2_12_g3_bundle_latest.synthetic_data_only_flag\", NotesUsedForStatus=false],",
                "        [ControlCode=\"NO_PII\", ResultStatus=if G3Latest[no_pii_flag] then \"PASS\" else \"FAIL\", ObservedValue=Text.From(G3Latest[no_pii_flag]), ExpectedValue=\"true\", ControlClass=\"BOUNDARY\", Boundary=\"No PII.\", StatusAuthority=\"m2_12_g3_bundle_latest.no_pii_flag\", NotesUsedForStatus=false],",
                "        [ControlCode=\"PRODUCTION_ACTION_NOT_AUTHORIZED\", ResultStatus=if not G3Latest[production_action_authorized_flag] then \"PASS\" else \"FAIL\", ObservedValue=Text.From(G3Latest[production_action_authorized_flag]), ExpectedValue=\"false\", ControlClass=\"BOUNDARY\", Boundary=\"No production action.\", StatusAuthority=\"m2_12_g3_bundle_latest.production_action_authorized_flag\", NotesUsedForStatus=false],",
                "        [ControlCode=\"CAUSAL_OPTIMIZATION_NOT_AUTHORIZED\", ResultStatus=if not G3Latest[empirical_or_causal_optimization_authorized_flag] then \"PASS\" else \"FAIL\", ObservedValue=Text.From(G3Latest[empirical_or_causal_optimization_authorized_flag]), ExpectedValue=\"false\", ControlClass=\"BOUNDARY\", Boundary=\"No causal or empirical optimization claim.\", StatusAuthority=\"m2_12_g3_bundle_latest.empirical_or_causal_optimization_authorized_flag\", NotesUsedForStatus=false],",
                "        [ControlCode=\"DEPLOYMENT_NOT_AUTHORIZED\", ResultStatus=if not G3Latest[deployment_authorized_flag] then \"PASS\" else \"FAIL\", ObservedValue=Text.From(G3Latest[deployment_authorized_flag]), ExpectedValue=\"false\", ControlClass=\"BOUNDARY\", Boundary=\"No deployment authorization.\", StatusAuthority=\"m2_12_g3_bundle_latest.deployment_authorized_flag\", NotesUsedForStatus=false],",
                "        [ControlCode=\"LEGAL_REGULATORY_NOT_CERTIFIED\", ResultStatus=if not G3Latest[legal_or_regulatory_certified_flag] then \"PASS\" else \"FAIL\", ObservedValue=Text.From(G3Latest[legal_or_regulatory_certified_flag]), ExpectedValue=\"false\", ControlClass=\"BOUNDARY\", Boundary=\"No legal or regulatory certification.\", StatusAuthority=\"m2_12_g3_bundle_latest.legal_or_regulatory_certified_flag\", NotesUsedForStatus=false]",
                "    },",
                "    T = Table.FromRecords(Rows),",
                "    AddRun = Table.AddColumn(T, \"module1_run_id\", each pCampaignOrRunId, Int64.Type),",
                "    AddKey = Table.AddColumn(AddRun, \"GovernanceControlKey\", each fxKeyPart([module1_run_id]) & \"|\" & [ControlCode], type text)",
                "in",
                "    AddKey"
              ],
              "type": "m"
            }
          }
        ]
      },
