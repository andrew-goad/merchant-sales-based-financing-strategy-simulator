          {
            "name": "P03 Intervention",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string",
            "expression": [
              "",
              "SWITCH (",
              "    FactIntervention[strategy_outcome_code],",
              "    \"CLOSED_NO_FURTHER_ACTION\", \"No further action\",",
              "    \"TARGETED_MERCHANT_OUTREACH_REVIEW\", \"Merchant outreach review\",",
              "    \"TEMPORARY_REMITTANCE_ADJUSTMENT_REVIEW\", \"Remittance adjustment review\",",
              "    SUBSTITUTE (",
              "        FactIntervention[strategy_outcome_code],",
              "        \"_\",",
              "        \" \"",
              "    )",
              ")"
            ],
            "isDataTypeInferred": true,
            "lineageTag": "d5b3c86d-ccf6-4fd7-afd1-bc8f5889adcd",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "P03 Servicing Action",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string",
            "expression": [
              "",
              "SWITCH (",
              "    FactIntervention[servicing_action_code],",
              "    \"NO_ACTION_CLOSED\", \"No action — closed\",",
              "    \"OUTREACH_REVIEW_QUEUE\", \"Outreach review\",",
              "    \"TEMPORARY_REMITTANCE_REVIEW\", \"Remittance review\",",
              "    SUBSTITUTE (",
              "        FactIntervention[servicing_action_code],",
              "        \"_\",",
              "        \" \"",
              "    )",
              ")"
            ],
            "isDataTypeInferred": true,
            "lineageTag": "7e6605b3-606f-497f-b6ea-7a43ad9bf404",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "P03 Servicing Queue",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string",
            "expression": [
              "",
              "SWITCH (",
              "    FactIntervention[servicing_queue_code],",
              "    \"CLOSED\", \"Closed\",",
              "    \"SERVICING_REVIEW\", \"Servicing review\",",
              "    SUBSTITUTE (",
              "        FactIntervention[servicing_queue_code],",
              "        \"_\",",
              "        \" \"",
              "    )",
              ")"
            ],
            "isDataTypeInferred": true,
