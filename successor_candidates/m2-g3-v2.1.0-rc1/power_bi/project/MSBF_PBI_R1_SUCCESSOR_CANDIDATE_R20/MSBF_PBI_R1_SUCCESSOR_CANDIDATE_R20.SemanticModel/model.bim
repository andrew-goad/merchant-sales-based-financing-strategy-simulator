        "description": "Accepted M2.10 KPI snapshot.",
        "isHidden": true,
        "lineageTag": "7a96ca1c-a9d9-5bf3-8026-f5fa6d260d7a",
        "partitions": [
          {
            "name": "FactPortfolioKPIEndpoint",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = stg_msbf_m2_portfolio_kpi_snapshot,",
                "    NormalizeScope = Table.AddColumn(Source, \"ReportingScopeCode\", each if [scope_code] = \"PORTFOLIO_ALL\" then \"PORTFOLIO\" else [scope_code], type text),",
                "    AddSourceScope = Table.AddColumn(NormalizeScope, \"SourceScopeCode\", each [scope_code], type text),",
                "    AddScopeKey = Table.AddColumn(AddSourceScope, \"ReportingScopeKey\", each fxKeyPart([module1_run_id]) & \"|\" & [ReportingScopeCode], type text),",
                "    AddFactKey = Table.AddColumn(AddScopeKey, \"ScopeKPIKey\", each [ReportingScopeKey] & \"|\" & fxKeyPart([kpi_code]), type text)",
                "in",
                "    AddFactKey"
              ],
              "type": "m"
            }
          }
        ]
      },
