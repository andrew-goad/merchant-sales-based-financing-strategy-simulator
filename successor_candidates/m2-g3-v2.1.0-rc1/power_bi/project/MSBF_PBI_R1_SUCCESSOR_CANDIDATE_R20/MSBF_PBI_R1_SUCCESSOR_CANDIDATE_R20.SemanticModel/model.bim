        "description": "Canonical account/advance identity; synthetic account and advance IDs retained as alternate keys.",
        "lineageTag": "6d221237-f731-412c-8145-55477b318c0b",
        "partitions": [
          {
            "name": "DimAccountAdvance",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Activation = stg_msbf_m2_initial_portfolio_activation,",
                "    BookingKeep = Table.SelectColumns(stg_msbf_m2_application_booking_funding_activation_latest, {\"module1_run_id\",\"scenario_id\",\"merchant_application_id\",\"funded_amount\",\"activation_remittance_rate\",\"activation_payback_multiple\",\"activation_collection_horizon_days\",\"activation_total_repayment_amount\",\"activation_finance_charge_amount\",\"activation_implied_daily_collection_amount\",\"activation_implied_payoff_days\",\"booking_date\",\"funding_date\",\"portfolio_activation_date\",\"first_expected_remittance_date\",\"monitoring_start_date\",\"activation_outcome_code\"}),",
                "    JoinBooking = Table.NestedJoin(Activation, {\"module1_run_id\",\"scenario_id\",\"merchant_application_id\"}, BookingKeep, {\"module1_run_id\",\"scenario_id\",\"merchant_application_id\"}, \"Booking\", JoinKind.LeftOuter),",
                "    BookingColumns = List.RemoveItems(Table.ColumnNames(BookingKeep), {\"module1_run_id\",\"scenario_id\",\"merchant_application_id\",\"portfolio_activation_date\",\"monitoring_start_date\"}),",
                "    ExpandBooking = Table.ExpandTableColumn(JoinBooking, \"Booking\", BookingColumns, BookingColumns),",
                "    AddApplicationKey = Table.AddColumn(ExpandBooking, \"ApplicationKey\", each fxKeyPart([module1_run_id]) & \"|\" & fxKeyPart([merchant_application_id]), type text),",
                "    AddScenarioKey = Table.AddColumn(AddApplicationKey, \"RunScenarioKey\", each fxKeyPart([module1_run_id]) & \"|\" & fxKeyPart([scenario_id]), type text),",
                "    AddAccountKey = Table.AddColumn(AddScenarioKey, \"AccountKey\", each fxKeyPart([module1_run_id]) & \"|\" & fxKeyPart([scenario_id]) & \"|\" & fxKeyPart([merchant_application_id]), type text)",
                "in AddAccountKey"
              ],
              "type": "m"
            }
          }
        ]
      },
