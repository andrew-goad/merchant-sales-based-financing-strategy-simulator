          },
          {
            "name": "__Account Monitoring Status As Of",
            "annotations": [
              {
                "name": "MSBF_ActivationWave",
                "value": "A1b"
              },
              {
                "name": "MSBF_LocalEngineStatus",
                "value": "PENDING_A1B_LOCAL_ENGINE_EVIDENCE"
              }
            ],
            "displayFolder": "99 Helpers\\As Of",
            "expression": [
              "VAR LatestDate = [__Account Latest Monitoring Date As Of]",
              "RETURN",
              "    IF (",
              "        NOT ISBLANK ( LatestDate ),",
              "        CALCULATE (",
              "            SELECTEDVALUE ( 'FactAccountDaily'[monitoring_status_code] ),",
              "            REMOVEFILTERS ( 'DimDate' ),",
              "            FILTER (",
              "                ALL ( 'FactAccountDaily'[monitoring_date] ),",
              "                'FactAccountDaily'[monitoring_date] = LatestDate",
              "            )",
              "        )",
              "    )"
            ],
            "formatString": "General",
            "isHidden": true,
            "lineageTag": "131155fd-a8e2-5a3d-bdd7-7b59159c19a5"
          },
          {
            "name": "__Account Paid Off Flag As Of",
            "annotations": [
              {
                "name": "MSBF_ActivationWave",
                "value": "A1b"
              },
              {
                "name": "MSBF_LocalEngineStatus",
                "value": "PENDING_A1B_LOCAL_ENGINE_EVIDENCE"
              }
            ],
            "displayFolder": "99 Helpers\\As Of",
            "expression": [
              "VAR LatestDate = [__Account Latest Monitoring Date As Of]",
              "RETURN",
              "    IF (",
              "        NOT ISBLANK ( LatestDate ),",
              "        CALCULATE (",
              "            MAXX ( 'FactAccountDaily', IF ( 'FactAccountDaily'[paid_off_flag], 1, 0 ) ),",
              "            REMOVEFILTERS ( 'DimDate' ),",
              "            FILTER (",
              "                ALL ( 'FactAccountDaily'[monitoring_date] ),",
              "                'FactAccountDaily'[monitoring_date] = LatestDate",
              "            )",
              "        ),",
              "        0",
              "    )"
            ],
            "formatString": "0",
            "isHidden": true,
            "lineageTag": "9969e5d3-01e0-563b-b393-e1722c77e1d4"
          },
          {
            "name": "__Account Active Alert Count As Of",
            "annotations": [
              {
                "name": "MSBF_ActivationWave",
                "value": "A1b"
              },
              {
                "name": "MSBF_LocalEngineStatus",
                "value": "PENDING_A1B_LOCAL_ENGINE_EVIDENCE"
              }
            ],
            "displayFolder": "99 Helpers\\As Of",
            "expression": [
              "VAR LatestDate = [__Account Latest Monitoring Date As Of]",
              "RETURN",
              "    IF (",
              "        NOT ISBLANK ( LatestDate ),",
              "        CALCULATE (",
              "            MAXX (",
              "                'FactAccountDaily',",
              "                IF ( 'FactAccountDaily'[daily_shortfall_alert_flag], 1, 0 )",
              "                    + IF ( 'FactAccountDaily'[cumulative_pace_watch_alert_flag], 1, 0 )",
              "                    + IF ( 'FactAccountDaily'[cumulative_pace_high_alert_flag], 1, 0 )",
              "                    + IF ( 'FactAccountDaily'[zero_sales_streak_alert_flag], 1, 0 )",
              "                    + IF ( 'FactAccountDaily'[liquidity_stress_alert_flag], 1, 0 )",
              "                    + IF ( 'FactAccountDaily'[horizon_overrun_alert_flag], 1, 0 )",
              "            ),",
              "            REMOVEFILTERS ( 'DimDate' ),",
              "            FILTER (",
              "                ALL ( 'FactAccountDaily'[monitoring_date] ),",
              "                'FactAccountDaily'[monitoring_date] = LatestDate",
              "            )",
              "        ),",
              "        0",
              "    )"
            ],
            "formatString": "0",
            "isHidden": true,
            "lineageTag": "796dfd09-8f78-5910-b055-71fdf9af1fe9"
          },
          {
            "name": "__Account Pace Alert Flag As Of",
            "annotations": [
              {
                "name": "MSBF_ActivationWave",
                "value": "A1b"
              },
              {
                "name": "MSBF_LocalEngineStatus",
                "value": "PENDING_A1B_LOCAL_ENGINE_EVIDENCE"
              }
            ],
            "displayFolder": "99 Helpers\\As Of",
            "expression": [
              "VAR LatestDate = [__Account Latest Monitoring Date As Of]",
              "RETURN",
              "    IF (",
              "        NOT ISBLANK ( LatestDate ),",
              "        CALCULATE (",
              "            MAXX (",
              "                'FactAccountDaily',",
              "                IF (",
              "                    'FactAccountDaily'[cumulative_pace_watch_alert_flag]",
              "                        || 'FactAccountDaily'[cumulative_pace_high_alert_flag],",
              "                    1,",
              "                    0",
              "                )",
              "            ),",
              "            REMOVEFILTERS ( 'DimDate' ),",
              "            FILTER (",
              "                ALL ( 'FactAccountDaily'[monitoring_date] ),",
              "                'FactAccountDaily'[monitoring_date] = LatestDate",
              "            )",
              "        ),",
              "        0",
              "    )"
            ],
            "formatString": "0",
            "isHidden": true,
            "lineageTag": "5baf38bb-6d5f-5503-a5e6-551eea526256"
          },
          {
            "name": "__Account First Paid Off Day As Of",
            "annotations": [
              {
                "name": "MSBF_ActivationWave",
                "value": "A1b"
              },
              {
                "name": "MSBF_LocalEngineStatus",
                "value": "PENDING_A1B_LOCAL_ENGINE_EVIDENCE"
              }
            ],
            "displayFolder": "99 Helpers\\As Of",
            "expression": [
              "VAR AsOfDate = [Selected As Of Date]",
              "RETURN",
              "    IF (",
              "        [__Account Observable Flag As Of] = 1,",
              "        CALCULATE (",
              "            MIN ( 'FactAccountDaily'[monitoring_day_index] ),",
              "            REMOVEFILTERS ( 'DimDate' ),",
              "            FILTER (",
              "                ALL ( 'FactAccountDaily'[monitoring_date] ),",
              "                'FactAccountDaily'[monitoring_date] <= AsOfDate",
              "            ),",
              "            'FactAccountDaily'[paid_off_flag] = TRUE ()",
              "        )",
              "    )"
            ],
            "formatString": "0",
            "isHidden": true,
            "lineageTag": "b790f8c8-4129-55e5-89bb-9dd3a28f0ba0"
          },
          {
            "name": "__Account Payoff Slippage Days",
            "annotations": [
              {
                "name": "MSBF_ActivationWave",
                "value": "A1b"
              },
              {
                "name": "MSBF_LocalEngineStatus",
                "value": "PENDING_A1B_LOCAL_ENGINE_EVIDENCE"
              }
            ],
            "description": "Negative values identify payoff before the accepted implied payoff day; open-account slippage is floored at zero.",
            "displayFolder": "99 Helpers\\As Of",
            "expression": [
              "VAR Observable = [__Account Observable Flag As Of]",
              "VAR ImpliedDays = SELECTEDVALUE ( 'DimAccountAdvance'[activation_implied_payoff_days] )",
              "VAR PaidOff = [__Account Paid Off Flag As Of]",
              "VAR ActualPayoffDay = [__Account First Paid Off Day As Of]",
              "VAR CurrentDay = [__Account Monitoring Day Index As Of]",
              "RETURN",
              "    IF (",
              "        Observable = 1 && NOT ISBLANK ( ImpliedDays ),",
              "        IF (",
              "            PaidOff = 1 && NOT ISBLANK ( ActualPayoffDay ),",
              "            ActualPayoffDay - ImpliedDays,",
              "            MAX ( 0, CurrentDay - ImpliedDays )",
              "        )",
              "    )"
            ],
            "formatString": "0.0",
            "isHidden": true,
            "lineageTag": "b5a08844-d85b-5e6c-9dec-5540fb932c1a"
          },
          {
            "name": "Selected As Of Date",
            "annotations": [
              {
                "name": "MSBF_ActivationWave",
                "value": "A1b"
              },
              {
