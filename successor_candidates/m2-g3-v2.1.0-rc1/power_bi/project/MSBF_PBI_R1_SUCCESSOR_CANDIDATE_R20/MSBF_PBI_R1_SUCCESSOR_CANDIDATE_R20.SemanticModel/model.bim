        "description": "Visible run, population, release, hash, and source as-of identity. One run is loaded per refresh.",
        "lineageTag": "cc4a0b4c-ae36-499e-9bb4-9a46215da9cd",
        "partitions": [
          {
            "name": "DimRunCampaign",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = stg_msbf_ctl_run_registry,",
                "    AddKey = Table.AddColumn(Source, \"RunCampaignKey\", each fxKeyPart([run_id]), type text),",
                "    AddRelease = Table.AddColumn(AddKey, \"SourceRelease\", each pSourceRelease, type text),",
                "    AddModelVersion = Table.AddColumn(AddRelease, \"ModelDefinitionVersion\", each pModelDefinitionVersion, type text)",
                "in AddModelVersion"
              ],
              "type": "m"
            }
          }
        ]
      },
