            "displayFolder": "03 Portfolio",
            "expression": [
              "VAR AsOfDate = [Selected As Of Date]",
              "VAR WithinAuthorizedRange =",
              "    NOT ISBLANK ( AsOfDate )",
              "        && AsOfDate >= [Source Run As Of Date]",
              "        && AsOfDate <= [Portfolio Evidence Max Date]",
              "RETURN",
              "    IF (",
              "        WithinAuthorizedRange,",
              "        COALESCE (",
              "            CALCULATE (",
              "                DISTINCTCOUNT ( 'DimAccountAdvance'[AccountKey] ),",
              "                REMOVEFILTERS ( 'DimDate' ),",
              "                'DimAccountAdvance'[portfolio_activation_date] <= AsOfDate",
              "            ),",
              "            0",
              "        )",
              "    )"
            ],
            "formatString": "#,0",
            "lineageTag": "80f0945b-da60-51d6-a7cd-20a47efd3788"
          },
