              "    ),",
              "    BLANK ()",
              ")"
            ],
            "formatString": "#,0",
            "lineageTag": "83e941f7-5965-457e-b726-301dcebc7af9"
          },
          {
            "name": "P01 Decision Outcome Sort Rank",
            "expression": [
              "",
              "VAR DecisionPaths = [Decisioned Applications]",
              "RETURN",
              "    IF (",
              "        NOT ISBLANK ( DecisionPaths ) && DecisionPaths > 0,",
              "        SELECTEDVALUE ( 'DimDecisionOutcome'[final_decision_outcome_rank] )",
              "    )"
            ],
            "formatString": "0",
            "lineageTag": "b750a07c-9af6-4d31-bb54-42717b41cacf"
          },
          {
            "name": "P01 G2 Display",
            "expression": [
              "",
              "IF ( [G2 Contract Pass] = 1, \"PASS\", \"HOLD\" )"
            ],
            "lineageTag": "b90de904-059b-4a1a-8a33-2d16c2dcc010"
          },
          {
            "name": "P01 G3 Display",
            "expression": [
              "",
              "IF ( [G3 Contract Pass] = 1, \"PASS\", \"HOLD\" )"
            ],
            "lineageTag": "369b329d-bb42-4380-913c-7c00dca71a36"
          },
          {
            "name": "P01 Source Reconciliation Display",
            "expression": [
              "",
              "IF ( [Source Reconciliation Pass] = 1, \"PASS\", \"HOLD\" )"
            ],
            "lineageTag": "820d6abd-a7a1-47b4-9ed5-e0a4a1f50cb2"
          },
          {
            "name": "P01 Endpoint Display",
            "expression": [
              "",
              "IF ( [Endpoint Evidence Available] = 1, \"PASS\", \"HOLD\" )"
            ],
            "lineageTag": "bd2230be-47b9-4c91-ab56-12ac3aed482e"
          },
          {
            "name": "P01 Evidence Status Display",
            "expression": [
              "",
              "VAR _Status = [As Of Evidence Status]",
              "RETURN",
              "    SWITCH (",
              "        _Status,",
              "        \"VALID\", \"VALID\",",
              "        \"NOT_YET_OBSERVABLE\", \"NOT OBSERVABLE\",",
              "        \"HOLD_OUTSIDE_EVIDENCE\", \"OUTSIDE EVIDENCE\",",
              "        _Status",
              "    )"
            ],
            "lineageTag": "3495c964-be60-4a5f-b503-f3eb12ad2664"
          },
          {
            "name": "P02 Cohort Funded Accounts",
            "expression": [
              "",
              "VAR _EndpointDate =",
              "    CALCULATE (",
              "        [Portfolio Evidence Max Date],",
              "        REMOVEFILTERS ( 'DimAsOfDate' )",
              "    )",
              "RETURN",
              "    CALCULATE (",
              "        [Funded Account Count],",
              "        REMOVEFILTERS ( 'DimAsOfDate' ),",
              "        TREATAS (",
              "            { _EndpointDate },",
              "            'DimAsOfDate'[AsOfDate]",
              "        )",
              "    )"
            ],
            "formatString": "0",
            "lineageTag": "42fefd68-e5e6-4a05-9a5d-1fb10836ce8e"
          },
          {
            "name": "P02 Cohort Funded Amount",
            "expression": [
              "",
              "VAR _EndpointDate =",
              "    CALCULATE (",
              "        [Portfolio Evidence Max Date],",
              "        REMOVEFILTERS ( 'DimAsOfDate' )",
              "    )",
              "RETURN",
              "    CALCULATE (",
              "        [Funded Amount],",
              "        REMOVEFILTERS ( 'DimAsOfDate' ),",
              "        TREATAS (",
              "            { _EndpointDate },",
              "            'DimAsOfDate'[AsOfDate]",
              "        )",
              "    )"
            ],
            "formatString": "\\$#,0.###############;(\\$#,0.###############);\\$#,0.###############",
            "lineageTag": "184a873e-b056-4fe3-a88d-bcd2bab29092"
          },
          {
            "name": "P02 Average Funded Amount",
            "expression": [
              "",
              "DIVIDE (",
              "    [P02 Cohort Funded Amount],",
              "    [P02 Cohort Funded Accounts]",
              ")"
            ],
            "formatString": "\\$#,0.###############;(\\$#,0.###############);\\$#,0.###############",
            "lineageTag": "4d0f4c0d-08d2-4c07-90d8-d502bf8918aa"
          },
          {
            "name": "P03 Merchant Name",
            "expression": [
              "",
              "VAR _Merchant =",
              "    SELECTEDVALUE (",
              "        'DimMerchant'[synthetic_business_name]",
              "    )",
              "RETURN",
              "    IF (",
              "        ISBLANK ( _Merchant ),",
              "        \"SELECT MERCHANT\",",
              "        TRIM (",
              "            SUBSTITUTE (",
              "                _Merchant,",
              "                \"Synthetic Merchant\",",
              "                \"\"",
              "            )",
              "        )",
              "    )"
            ],
            "lineageTag": "73eceef2-638a-41dc-b2bf-d5b978a76c3a"
          },
          {
            "name": "P03 Industry",
            "expression": [
              "",
              "VAR _IndustryCode =",
              "    SELECTEDVALUE ( 'DimMerchant'[industry_code] )",
              "RETURN",
              "    IF (",
              "        ISBLANK ( _IndustryCode ),",
              "        \"NOT AVAILABLE\",",
              "        CALCULATE (",
              "            SELECTEDVALUE ( 'DimIndustry'[industry_name] ),",
              "            TREATAS (",
              "                { _IndustryCode },",
              "                'DimIndustry'[industry_code]",
              "            )",
              "        )",
              "    )"
            ],
            "lineageTag": "437a6cbe-94e3-4d35-a754-273047baa2b3"
          },
          {
            "name": "P03 Merchant Size Tier",
            "expression": [
              "",
              "VAR _Value =",
              "    SELECTEDVALUE ( 'DimMerchant'[merchant_size_tier] )",
              "RETURN",
              "    SWITCH (",
              "        _Value,",
              "        \"LOWER_MIDDLE\", \"Lower middle\",",
              "        \"UPPER_MIDDLE\", \"Upper middle\",",
              "        \"SMALL\", \"Small\",",
              "        \"LARGE\", \"Large\",",
              "        IF (",
              "            ISBLANK ( _Value ),",
              "            \"NOT AVAILABLE\",",
              "            SUBSTITUTE ( _Value, \"_\", \" \" )",
              "        )",
              "    )"
            ],
            "lineageTag": "8c18c357-0eba-4acd-bd55-32f39aee0d51"
          },
          {
            "name": "P03 Annual Sales Band",
            "expression": [
              "",
              "VAR _Value =",
              "    SELECTEDVALUE ( 'DimMerchant'[annual_sales_band] )",
              "RETURN",
              "    SWITCH (",
              "        _Value,",
              "        \"UNDER_1M\", \"< $1M\",",
              "        \"1M_TO_5M\", \"$1M–$5M\",",
              "        \"5M_TO_10M\", \"$5M–$10M\",",
              "        \"10M_TO_25M\", \"$10M–$25M\",",
              "        \"25M_PLUS\", \"$25M+\",",
              "        IF (",
              "            ISBLANK ( _Value ),",
              "            \"NOT AVAILABLE\",",
              "            SUBSTITUTE ( _Value, \"_\", \" \" )",
              "        )",
              "    )"
            ],
            "lineageTag": "1806b44d-c283-41be-8c40-ae47e68e7f42"
          },
          {
            "name": "P03 Relationship Stage",
            "expression": [
              "",
              "VAR _Value =",
              "    SELECTEDVALUE ( 'DimMerchant'[relationship_stage] )",
              "RETURN",
              "    IF (",
              "        ISBLANK ( _Value ),",
              "        \"NOT AVAILABLE\",",
              "        SWITCH (",
              "            _Value,",
              "            \"NEW\", \"New\",",
              "            \"EXISTING\", \"Existing\",",
              "            \"RETURNING\", \"Returning\",",
              "            SUBSTITUTE ( _Value, \"_\", \" \" )",
              "        )",
              "    )"
            ],
            "lineageTag": "73edeb70-8d7f-4e9c-ab59-cb186f9850d2"
          },
          {
            "name": "P03 Relationship Quality",
            "expression": [
              "",
              "VAR _Tier =",
              "    SELECTEDVALUE ( 'DimMerchant'[relationship_quality_tier] )",
              "RETURN",
              "    IF (",
              "        ISBLANK ( _Tier ),",
              "        \"NOT AVAILABLE\",",
              "        \"Tier \" & FORMAT ( _Tier, \"0\" )",
              "    )"
            ],
            "lineageTag": "69080796-bfb6-457c-b62f-ac44b7e522de"
          },
          {
            "name": "P03 Prior Advance Count",
            "expression": [
              "",
              "SELECTEDVALUE (",
              "    'DimMerchant'[prior_advance_count]",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "c2267e1b-47a7-4a5f-8e32-bc6abe84bfa1"
          },
          {
