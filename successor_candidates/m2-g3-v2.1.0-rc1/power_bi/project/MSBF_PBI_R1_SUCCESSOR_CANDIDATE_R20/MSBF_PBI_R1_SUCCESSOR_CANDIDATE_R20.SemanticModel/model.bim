      {
        "name": "stg_POWER_BI_DATA_CATALOG",
        "annotations": [
          {
            "name": "MSBF_ActivationWave",
            "value": "A1a"
          },
          {
            "name": "MSBF_LoadEnabled",
            "value": "false"
          }
        ],
        "expression": [
          "// Catalog authority for all core CSV reads.",
          "let",
          "    Root = Text.TrimEnd(pDataRoot, {\"/\", \"\\\"}),",
          "    Path = Root & \"\\data\\POWER_BI_DATA_CATALOG.csv\",",
          "    Raw = Csv.Document(File.Contents(Path), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
          "    Headers = Table.PromoteHeaders(Raw, [PromoteAllScalars=true]),",
          "    Typed = Table.TransformColumnTypes(Headers, {",
          "        {\"schema\", type text}, {\"object\", type text}, {\"rows\", Int64.Type}, {\"columns\", Int64.Type},",
          "        {\"bytes\", Int64.Type}, {\"sha256\", type text}, {\"role\", type text}, {\"primary_pages\", type text},",
          "        {\"import_priority\", type text}, {\"package_path\", type text}, {\"original_source_path\", type text}, {\"header_json\", type text}",
          "    }, \"en-US\")",
          "in",
          "    Typed"
        ],
        "kind": "m",
        "lineageTag": "7f2c6a9b-a065-4aee-a47b-5b8c56b7aac4"
      },
      {
        "name": "fxReadCatalogedCsv",
        "annotations": [
          {
            "name": "MSBF_ActivationWave",
            "value": "A1a"
          },
          {
            "name": "MSBF_LoadEnabled",
            "value": "false"
          }
        ],
        "expression": [
          "// Governed CSV reader: exact catalog row, path, ordered header, and row-count checks.",
          "(schemaName as text, objectName as text) as table =>",
          "let",
          "    Matches = Table.SelectRows(stg_POWER_BI_DATA_CATALOG, each [schema] = schemaName and [object] = objectName),",
          "    CatalogRow = if Table.RowCount(Matches) <> 1 then error Error.Record(\"CATALOG_LOOKUP\", \"Expected exactly one catalog row.\", [Schema=schemaName, Object=objectName, Matches=Table.RowCount(Matches)]) else Matches{0},",
          "    Root = Text.TrimEnd(pDataRoot, {\"/\", \"\\\"}),",
          "    RelativePath = Text.Replace(CatalogRow[package_path], \"/\", \"\\\"),",
          "    FullPath = Root & \"\\\" & RelativePath,",
          "    Raw = try Csv.Document(File.Contents(FullPath), [Delimiter=\",\", Columns=CatalogRow[columns], Encoding=65001, QuoteStyle=QuoteStyle.Csv])",
          "          otherwise error Error.Record(\"SOURCE_READ\", \"Required source could not be read.\", [Path=FullPath, Schema=schemaName, Object=objectName]),",
          "    Headers = Table.PromoteHeaders(Raw, [PromoteAllScalars=true]),",
          "    ExpectedColumns = Json.Document(Text.ToBinary(CatalogRow[header_json], TextEncoding.Utf8)),",
          "    ActualColumns = Table.ColumnNames(Headers),",
          "    MissingColumns = List.Difference(ExpectedColumns, ActualColumns),",
          "    UnexpectedColumns = List.Difference(ActualColumns, ExpectedColumns),",
          "    HeaderCheck = if MissingColumns <> {} or UnexpectedColumns <> {} or ActualColumns <> ExpectedColumns",
          "        then error Error.Record(\"HEADER_MISMATCH\", \"Source header does not match the governing catalog.\", [Path=FullPath, Missing=MissingColumns, Unexpected=UnexpectedColumns, Expected=ExpectedColumns, Actual=ActualColumns])",
          "        else true,",
          "    RowCount = Table.RowCount(Headers),",
          "    RowCheck = if RowCount <> CatalogRow[rows]",
          "        then error Error.Record(\"ROW_COUNT_MISMATCH\", \"Source row count does not match the governing catalog.\", [Path=FullPath, Expected=CatalogRow[rows], Actual=RowCount])",
          "        else true,",
          "    Result = if HeaderCheck and RowCheck then",
          "        Value.ReplaceMetadata(Headers, [SourceSchema=schemaName, SourceObject=objectName, PackagePath=CatalogRow[package_path], CatalogRows=CatalogRow[rows], CatalogSha256=CatalogRow[sha256], SourceRelease=pSourceRelease])",
          "        else error Error.Record(\"SOURCE_VALIDATION\", \"Source validation did not complete successfully.\", [Path=FullPath])",
          "in",
          "    Result"
        ],
        "kind": "m",
        "lineageTag": "a58a590d-d7b4-4592-8f0f-0d4c7665460f"
      },
      {
        "name": "fxKeyPart",
        "annotations": [
          {
            "name": "MSBF_ActivationWave",
            "value": "A1a"
          },
          {
            "name": "MSBF_LoadEnabled",
            "value": "false"
          }
        ],
        "expression": [
          "// Stable, culture-invariant key part. Null remains an empty marker only when the caller deliberately permits it.",
          "(value as any) as text =>",
          "    if value = null then \"\" else if Value.Is(value, type date) then Date.ToText(value, \"yyyyMMdd\", \"en-US\") else Text.From(value, \"en-US\")"
        ],
        "kind": "m",
        "lineageTag": "faacd3bc-0957-46f6-ab89-6cc44ccc07d7"
      },
      {
        "name": "fxLatestOnOrBefore",
        "annotations": [
          {
            "name": "MSBF_ActivationWave",
            "value": "A1a"
          },
          {
            "name": "MSBF_LoadEnabled",
            "value": "false"
          }
        ],
        "expression": [
          "// Returns the latest source row on or before asOfDate for each key. No interpolation or extrapolation.",
          "(source as table, keyColumns as list, dateColumn as text, asOfDate as date) as table =>",
          "let",
          "    Filtered = Table.SelectRows(source, each Record.Field(_, dateColumn) <> null and Date.From(Record.Field(_, dateColumn)) <= asOfDate),",
          "    NonKeyColumns = List.RemoveItems(Table.ColumnNames(Filtered), keyColumns),",
          "    Grouped = Table.Group(Filtered, keyColumns, {{\"LatestRecord\", each Table.First(Table.Sort(_, {{dateColumn, Order.Descending}})), type record}}),",
          "    Expanded = Table.ExpandRecordColumn(Grouped, \"LatestRecord\", NonKeyColumns, NonKeyColumns)",
          "in",
          "    Expanded"
        ],
        "kind": "m",
        "lineageTag": "91d6f13e-5927-4c44-af28-2fe35ad9fb22"
      },
      {
        "name": "fxAssertSelectedRun",
        "annotations": [
          {
            "name": "MSBF_ActivationWave",
            "value": "A1a"
          },
          {
            "name": "MSBF_LoadEnabled",
            "value": "false"
          }
        ],
        "expression": [
          "// Fails when a query leaks rows from another run.",
          "(source as table, runColumn as text) as table =>",
          "let",
          "    RunValues = List.Distinct(List.RemoveNulls(Table.Column(source, runColumn))),",
          "    Check = if List.Count(RunValues) <> 1 or Number.From(RunValues{0}) <> Number.From(pCampaignOrRunId)",
          "        then error Error.Record(\"RUN_IDENTITY_MISMATCH\", \"Query does not contain exactly the selected run.\", [RunColumn=runColumn, Observed=RunValues, Expected=pCampaignOrRunId])",
          "        else true",
          "in",
          "    if Check then source else source"
        ],
        "kind": "m",
        "lineageTag": "24fc45d1-7529-4a54-9e9c-f3c876839386"
      },
      {
        "name": "stg_msbf_ctl_acceptance_gate_result",
        "annotations": [
          {
            "name": "MSBF_ActivationWave",
            "value": "A1a"
          },
          {
            "name": "MSBF_LoadEnabled",
            "value": "false"
          }
        ],
        "expression": [
          "// Source: msbf_ctl.acceptance_gate_result",
          "// Catalog path: data/core/msbf_ctl/acceptance_gate_result.csv",
