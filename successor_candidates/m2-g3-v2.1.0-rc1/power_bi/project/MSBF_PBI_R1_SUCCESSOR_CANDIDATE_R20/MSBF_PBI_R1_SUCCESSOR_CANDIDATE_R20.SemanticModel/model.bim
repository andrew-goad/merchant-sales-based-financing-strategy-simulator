        "description": "Prevent future leakage and drive latest-on-or-before measures.",
        "lineageTag": "3abbb74c-807b-432a-9c64-fd55fecc820b",
        "partitions": [
          {
            "name": "DimAsOfDate",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Table.SelectColumns(DimDate, {\"Date\",\"Year\",\"Quarter\",\"MonthNumber\",\"MonthName\",\"MonthYear\",\"IsEvidenceEndpoint\",\"IsSourceRunAsOf\"}),",
                "    Renamed = Table.RenameColumns(Source, {{\"Date\",\"AsOfDate\"}}),",
                "    AddDefault = Table.AddColumn(Renamed, \"IsDefaultAsOf\", each [AsOfDate] = pDefaultAsOfDate, type logical)",
                "in AddDefault"
              ],
              "type": "m"
            }
          }
        ]
      },
