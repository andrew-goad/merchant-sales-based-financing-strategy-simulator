          {
            "name": "P04 Servicing Disposition",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string",
            "expression": [
              "",
              "SWITCH (",
              "    FactServicingExecution[servicing_execution_outcome_code],",
              "    \"NO_SERVICING_EXECUTION_REQUIRED\", \"No servicing required\",",
              "    \"SIMULATED_TEMPORARY_PAYMENT_PROCESSING_ACTIVE\", \"Active servicing\",",
              "    \"SERVICING_EXECUTION_REVIEW_HOLD\", \"Review hold\",",
              "    SUBSTITUTE (",
              "        FactServicingExecution[servicing_execution_outcome_code],",
              "        \"_\",",
              "        \" \"",
              "    )",
              ")"
            ],
            "isDataTypeInferred": true,
            "lineageTag": "6d9ac80a-3f82-492b-bbc6-458966b6aec6",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "P04 Attention Driver",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string",
            "expression": [
              "",
              "SWITCH (",
              "    FactServicingExecution[primary_execution_reason_code],",
              "    \"M2_8_REASON_SOURCE_TEMPORARY_PROCESSING\", \"Temporary processing required\",",
              "    \"M2_8_REASON_SOURCE_REVIEW_HOLD\", \"Governance review required\",",
              "    \"M2_8_REASON_SOURCE_NO_PROCESSING\", \"No servicing required\",",
              "    SUBSTITUTE (",
              "        FactServicingExecution[primary_execution_reason_code],",
              "        \"_\",",
              "        \" \"",
              "    )",
              ")"
            ],
            "isDataTypeInferred": true,
            "lineageTag": "32304ec8-dedc-440c-92d5-5077d5af105f",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "P04 Servicing Action",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string",
            "expression": [
              "",
              "SWITCH (",
              "    FactServicingExecution[servicing_execution_action_code],",
              "    \"EXECUTE_TEMPORARY_SYNTHETIC_PAYMENT_CYCLE\", \"Temporary payment cycle\",",
              "    \"HOLD_FOR_SERVICING_REVIEW\", \"Hold for servicing review\",",
              "    \"NO_PAYMENT_PROCESSING\", \"No processing\",",
              "    SUBSTITUTE (",
              "        FactServicingExecution[servicing_execution_action_code],",
              "        \"_\",",
              "        \" \"",
              "    )",
              ")"
            ],
            "isDataTypeInferred": true,
            "lineageTag": "fd51664b-0fad-454f-b9f1-f11050a0516e",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "P04 Lifecycle State",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string",
            "expression": [
              "",
              "SWITCH (",
              "    FactServicingExecution[final_lifecycle_state_code],",
              "    \"REASSESSMENT_DUE\", \"Reassessment due\",",
              "    \"SERVICING_REVIEW_HOLD\", \"Servicing review hold\",",
              "    \"CLOSED_NO_PROCESSING_REQUIRED\", \"Closed — no processing\",",
              "    SUBSTITUTE (",
              "        FactServicingExecution[final_lifecycle_state_code],",
              "        \"_\",",
              "        \" \"",
              "    )",
              ")"
            ],
            "isDataTypeInferred": true,
            "lineageTag": "eae8a06b-f835-404e-98ff-095b7e4a1f3e",
            "summarizeBy": "none",
            "type": "calculated"
          }
        ],
        "description": "Synthetic servicing execution summary.",
        "lineageTag": "437c2cac-c123-5417-a15d-f22c6b54d4fc",
        "partitions": [
          {
            "name": "FactServicingExecution",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = stg_msbf_m2_application_servicing_execution_latest,",
                "    AddApplicationKey = Table.AddColumn(Source, \"ApplicationKey\", each fxKeyPart([module1_run_id]) & \"|\" & fxKeyPart([merchant_application_id]), type text),",
                "    AddRunScenarioKey = Table.AddColumn(AddApplicationKey, \"RunScenarioKey\", each fxKeyPart([module1_run_id]) & \"|\" & fxKeyPart([scenario_id]), type text),",
                "    AddApplicationScenarioKey = Table.AddColumn(AddRunScenarioKey, \"ApplicationScenarioKey\", each fxKeyPart([module1_run_id]) & \"|\" & fxKeyPart([scenario_id]) & \"|\" & fxKeyPart([merchant_application_id]), type text),",
                "    AddAccountKey = Table.AddColumn(AddApplicationScenarioKey, \"AccountKey\", each fxKeyPart([module1_run_id]) & \"|\" & fxKeyPart([scenario_id]) & \"|\" & fxKeyPart([merchant_application_id]), type text)",
                "in",
                "    AddAccountKey"
              ],
              "type": "m"
            }
          }
        ]
      },
