          {
            "name": "R1DimApplicationScenario",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = fxReadSuccessorCsv(\"R1DimApplicationScenario\"),",
                "    Typed = Table.TransformColumnTypes(Source, {",
                "            {\"module1_run_id\", Int64.Type},\n            {\"scenario_id\", Int64.Type},\n            {\"scenario_code\", type text},\n            {\"merchant_application_id\", type text},\n            {\"population_id\", type text},\n            {\"merchant_id\", type text},\n            {\"industry_code\", type text},\n            {\"merchant_size_tier\", type text},\n            {\"relationship_stage\", type text},\n            {\"partner_channel_id\", type text},\n            {\"channel_type\", type text},\n            {\"source_confidence_score\", type number},\n            {\"data_confidence_tier\", type text},\n            {\"verification_disposition\", type text},\n            {\"fraud_risk_tier\", Int64.Type},\n            {\"processor_continuity_status\", type text},\n            {\"feature_completeness_status\", type text},\n            {\"avg_daily_eligible_sales_30d\", type number},\n            {\"annualized_eligible_sales\", type number},\n            {\"average_available_balance_30d\", type number},\n            {\"negative_balance_day_rate_30d\", type number},\n            {\"nsf_count_30d\", Int64.Type},\n            {\"requested_amount\", type number},\n            {\"requested_remittance_rate\", type number},\n            {\"requested_payback_multiple\", type number},\n            {\"requested_horizon_days\", Int64.Type},\n            {\"requested_total_repayment_amount\", type number},\n            {\"requested_daily_remittance_amount\", type number},\n            {\"capacity_gate_outcome\", type text},\n            {\"economics_gate_outcome\", type text},\n            {\"stacking_depth\", Int64.Type},\n            {\"obligation_concentration_rate\", type number},\n            {\"search_required_flag\", type logical},\n            {\"search_attempted_flag\", type logical},\n            {\"search_complete_flag\", type logical},\n            {\"selected_candidate_id\", type text},\n            {\"selection_frontier\", type text},\n            {\"selected_candidate_type\", type text},\n            {\"selected_funding_amount\", type number},\n            {\"selected_remittance_rate\", type number},\n            {\"selected_payback_multiple\", type number},\n            {\"selected_horizon_days\", Int64.Type},\n            {\"selected_total_repayment_amount\", type number},\n            {\"selected_total_repayment_increase_amount\", type number},\n            {\"selected_total_repayment_increase_rate\", type number},\n            {\"selected_payment_coverage_ratio\", type number},\n            {\"selected_residual_daily_cash_flow\", type number},\n            {\"selected_post_financing_liquidity\", type number},\n            {\"selected_post_financing_buffer_days\", type number},\n            {\"selected_total_obligation_to_sales_rate\", type number},\n            {\"selected_stacking_depth\", Int64.Type},\n            {\"selected_resilience_tier\", Int64.Type},\n            {\"selected_integrated_risk_tier\", Int64.Type},\n            {\"selected_comparative_loss_rate\", type number},\n            {\"selected_risk_adjusted_contribution\", type number},\n            {\"selected_annualized_rar\", type number},\n            {\"human_review_required_flag\", type logical},\n            {\"human_review_reason_codes\", type text},\n            {\"binding_policy_gate_code\", type text},\n            {\"binding_policy_gate_codes\", type text},\n            {\"binding_policy_reason_code\", type text},\n            {\"binding_policy_reason_codes\", type text},\n            {\"independent_outcome_code\", type text},\n            {\"matched_baseline_outcome_code\", type text},\n            {\"stress_floor_applied_flag\", type logical},\n            {\"stress_floor_basis_code\", type text},\n            {\"governed_final_outcome_code\", type text},\n            {\"independent_selected_candidate_id\", type text},\n            {\"governed_selected_candidate_id\", type text},\n            {\"candidate_changed_by_floor_flag\", type logical},\n            {\"outcome_changed_by_floor_flag\", type logical},\n            {\"evidence_why_text\", type text},\n            {\"underwriting_why_text\", type text},\n            {\"decision_why_text\", type text},\n            {\"policy_profile_code\", type text},\n            {\"policy_profile_version\", Int64.Type},\n            {\"policy_profile_sha256\", type text},\n            {\"accepted_method_source_set_sha256\", type text},\n            {\"candidate_set_hash\", type text},\n            {\"decision_row_hash\", type text},\n            {\"evaluated_candidate_count\", Int64.Type},\n            {\"no_feasible_proof_available_flag\", type logical},\n            {\"no_feasible_proof_row_hash\", type text},\n            {\"power_bi_contract_version\", type text},\n            {\"ApplicationKey\", type text},\n            {\"RunScenarioKey\", type text},\n            {\"ApplicationScenarioKey\", type text},\n            {\"R1SourceBoundary\", type text},\n            {\"R1SourceArtifactSha256\", type text},\n            {\"R1AuthorityState\", type text}",
                "    }, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
