              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": [
              "",
              "SELECTEDVALUE (",
              "    'DimMerchant'[total_prior_funded_amount]",
              ")"
            ],
            "lineageTag": "085679d8-f91c-4eee-ae4b-170e8fdee939"
          },
