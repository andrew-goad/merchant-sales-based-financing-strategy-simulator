      {
        "name": "stg_R1_SUCCESSOR_DATA_CATALOG",
        "kind": "m",
        "expression": [
          "// R20 candidate catalog authority for successor CSV reads.",
          "let",
          "    Root = Text.TrimEnd(pSuccessorRoot, {\"/\", \"\\\"}),",
          "    Path = Root & \"\\SUCCESSOR_DATA_CATALOG.csv\",",
          "    Raw = Csv.Document(File.Contents(Path), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
          "    Headers = Table.PromoteHeaders(Raw, [PromoteAllScalars=true]),",
          "    Typed = Table.TransformColumnTypes(Headers, {{\"object\", type text}, {\"rows\", Int64.Type}, {\"columns\", Int64.Type}, {\"bytes\", Int64.Type}, {\"sha256\", type text}, {\"package_path\", type text}, {\"raw_package_path\", type text}, {\"raw_sha256\", type text}, {\"source_boundary\", type text}, {\"source_artifact_sha256\", type text}, {\"authority_state\", type text}, {\"grain\", type text}, {\"primary_key_contract\", type text}, {\"primary_pages\", type text}, {\"header_json\", type text}, {\"data_types_json\", type text}, {\"load_status\", type text}, {\"notes\", type text}}, \"en-US\")",
          "in",
          "    Typed"
        ],
        "annotations": [
          {
            "name": "MSBF_R20Authority",
            "value": "CANDIDATE_ONLY_PENDING_INDEPENDENT_AUDIT"
          }
        ]
      },
      {
        "name": "fxReadSuccessorCsv",
        "kind": "m",
        "expression": [
          "// Governed R20 reader: one catalog row, exact ordered header and row count.",
          "(objectName as text) as table =>",
          "let",
          "    Matches = Table.SelectRows(stg_R1_SUCCESSOR_DATA_CATALOG, each [object] = objectName and [load_status] = \"LOAD\"),",
          "    CatalogRow = if Table.RowCount(Matches) <> 1 then error Error.Record(\"R20_CATALOG_LOOKUP\", \"Expected exactly one R20 catalog row.\", [Object=objectName, Matches=Table.RowCount(Matches)]) else Matches{0},",
          "    Root = Text.TrimEnd(pSuccessorRoot, {\"/\", \"\\\"}),",
          "    RelativePath = Text.Replace(CatalogRow[package_path], \"/\", \"\\\"),",
          "    FullPath = Root & \"\\\" & RelativePath,",
          "    Raw = try Csv.Document(File.Contents(FullPath), [Delimiter=\",\", Columns=CatalogRow[columns], Encoding=65001, QuoteStyle=QuoteStyle.Csv]) otherwise error Error.Record(\"R20_SOURCE_READ\", \"Required R20 candidate source could not be read.\", [Path=FullPath, Object=objectName]),",
          "    Headers = Table.PromoteHeaders(Raw, [PromoteAllScalars=true]),",
          "    ExpectedColumns = Json.Document(Text.ToBinary(CatalogRow[header_json], TextEncoding.Utf8)),",
          "    ActualColumns = Table.ColumnNames(Headers),",
          "    HeaderCheck = if ActualColumns <> ExpectedColumns then error Error.Record(\"R20_HEADER_MISMATCH\", \"R20 source header does not match catalog.\", [Object=objectName, Expected=ExpectedColumns, Actual=ActualColumns]) else true,",
          "    RowCount = Table.RowCount(Headers),",
          "    RowCheck = if RowCount <> CatalogRow[rows] then error Error.Record(\"R20_ROW_COUNT_MISMATCH\", \"R20 source row count does not match catalog.\", [Object=objectName, Expected=CatalogRow[rows], Actual=RowCount]) else true,",
          "    Result = if HeaderCheck and RowCheck then Value.ReplaceMetadata(Headers, [R20Object=objectName, CatalogSha256=CatalogRow[sha256], SourceBoundary=CatalogRow[source_boundary], AuthorityState=CatalogRow[authority_state], SourceRelease=pSuccessorSourceRelease]) else error Error.Record(\"R20_SOURCE_VALIDATION\", \"R20 source validation failed.\", [Object=objectName])",
          "in",
          "    Result"
        ],
        "annotations": [
          {
            "name": "MSBF_R20Authority",
            "value": "CANDIDATE_ONLY_PENDING_INDEPENDENT_AUDIT"
          }
        ]
      }
    ],
