          {
            "name": "P03 Merchant Label",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string",
            "expression": [
              "",
              "VAR _Merchant =",
              "    'DimMerchant'[synthetic_business_name]",
              "RETURN",
              "    IF (",
              "        ISBLANK ( _Merchant ),",
              "        BLANK (),",
              "        RIGHT ( _Merchant, 6 )",
              "    )"
            ],
            "isDataTypeInferred": true,
            "lineageTag": "ee3c03cb-c212-45e4-bf51-2ae725664280",
            "summarizeBy": "none",
            "type": "calculated"
          }
        ],
        "description": "Merchant identity, industry, geography, relationship, and bounded opportunity attributes.",
        "lineageTag": "2112f13c-9ccb-4fd3-a223-209188a533c1",
        "partitions": [
          {
            "name": "DimMerchant",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    RunRow = DimRunCampaign{0},",
                "    SourceDate = Date.From(RunRow[as_of_date]),",
                "    Merchant = stg_msbf_m1_merchant_master,",
                "    IndustryActive = Table.SelectRows(stg_msbf_m1_merchant_industry_assignment, each [effective_start_date] <= SourceDate and ([effective_end_date] = null or [effective_end_date] >= SourceDate)),",
                "    IndustryKeep = Table.SelectColumns(IndustryActive, {\"merchant_id\",\"industry_code\",\"assignment_type\",\"revenue_share_rate\"}),",
                "    JoinIndustry = Table.NestedJoin(Merchant, {\"merchant_id\"}, IndustryKeep, {\"merchant_id\"}, \"Industry\", JoinKind.LeftOuter),",
                "    ExpandIndustry = Table.ExpandTableColumn(JoinIndustry, \"Industry\", {\"industry_code\",\"assignment_type\",\"revenue_share_rate\"}, {\"industry_code\",\"industry_assignment_type\",\"industry_revenue_share_rate\"}),",
                "    RelationshipKeep = Table.SelectColumns(stg_msbf_m1_merchant_relationship_snapshot, {\"merchant_id\",\"relationship_stage\",\"prior_advance_count\",\"completed_advance_count\",\"prior_default_flag\",\"prior_payment_interruption_flag\",\"total_prior_funded_amount\",\"total_prior_repaid_amount\",\"deposit_relationship_flag\",\"merchant_services_relationship_flag\",\"wallet_share_proxy\",\"relationship_quality_tier\"}),",
                "    JoinRelationship = Table.NestedJoin(ExpandIndustry, {\"merchant_id\"}, RelationshipKeep, {\"merchant_id\"}, \"Relationship\", JoinKind.LeftOuter),",
                "    ExpandRelationship = Table.ExpandTableColumn(JoinRelationship, \"Relationship\", List.RemoveItems(Table.ColumnNames(RelationshipKeep), {\"merchant_id\"}), List.RemoveItems(Table.ColumnNames(RelationshipKeep), {\"merchant_id\"})),",
                "    AddKey = Table.AddColumn(ExpandRelationship, \"MerchantKey\", each fxKeyPart([created_by_run_id]) & \"|\" & fxKeyPart([merchant_id]), type text)",
                "in AddKey"
              ],
              "type": "m"
            }
          }
        ]
      },
