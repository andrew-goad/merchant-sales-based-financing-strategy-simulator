          }
        ],
        "description": "Eighteen observed SRC_* codes mapped transparently to seven source families.",
        "lineageTag": "7fb19fc3-e4ad-4640-adba-319bd7f493d5",
        "partitions": [
          {
            "name": "DimAcquisitionSource",
            "mode": "import",
            "source": {
              "expression": [
                "// A1a authorized query definition; physical Power BI Desktop execution remains pending.",
                "// Existing semantic query: DimAcquisitionSource",
                "// New accepted source: msbf_m1.acquisition_source_profile",
                "// Purpose: replace PBI_ACQ_SOURCE_MAP_V1.0.0 hard-coded source-family mapping.",
                "// Model effect: no new semantic table, relationship, measure, or query.",
                "let",
                "    Source = fxReadCatalogedCsv(\"msbf_m1\", \"acquisition_source_profile\"),",
                "    Typed = Table.TransformColumnTypes(Source, {",
                "        {\"module1_run_id\", Int64.Type},",
                "        {\"acquisition_source_code\", type text},",
                "        {\"acquisition_source_name\", type text},",
                "        {\"normalized_source_family\", type text},",
                "        {\"source_subtype\", type text},",
                "        {\"source_classification\", type text},",
                "        {\"accepted_partner_channel_id\", type text},",
                "        {\"accepted_channel_type\", type text},",
                "        {\"source_owner_classification\", type text},",
                "        {\"vendor_partner_code\", type text},",
                "        {\"third_party_flag\", type logical},",
                "        {\"approved_source_flag\", type logical},",
                "        {\"governance_status\", type text},",
                "        {\"default_attribution_priority\", Int64.Type},",
                "        {\"effective_start_date\", type date},",
                "        {\"effective_end_date\", type date},",
                "        {\"source_evidence_status\", type text},",
                "        {\"row_hash\", type text},",
                "        {\"created_by_run_id\", Int64.Type},",
                "        {\"created_at\", type datetimezone}",
                "    }, \"en-US\"),",
                "    SelectedRun = fxAssertSelectedRun(Typed, \"module1_run_id\"),",
                "    Approved = Table.SelectRows(SelectedRun, each [approved_source_flag] = true and [governance_status] = \"APPROVED\"),",
                "    DuplicateSourceCount = Table.RowCount(Approved) - Table.RowCount(Table.Distinct(Approved, {\"module1_run_id\", \"acquisition_source_code\"})),",
                "    UniqueSources = if DuplicateSourceCount <> 0 then error Error.Record(",
                "        \"PBI_R3_DUPLICATE_ACQUISITION_SOURCE\",",
                "        \"Accepted acquisition source profile is not unique at run × acquisition_source_code.\",",
                "        [DuplicateRows = DuplicateSourceCount]",
                "    ) else Approved,",
                "    JoinFamily = Table.NestedJoin(",
                "        UniqueSources,",
                "        {\"normalized_source_family\"},",
                "        stg_msbf_ref_acquisition_source_family,",
                "        {\"source_family_code\"},",
                "        \"Family\",",
                "        JoinKind.LeftOuter",
                "    ),",
                "    ExpandFamily = Table.ExpandTableColumn(",
                "        JoinFamily,",
                "        \"Family\",",
                "        {\"source_family_name\", \"description\"},",
                "        {\"source_family_name\", \"source_family_description\"}",
                "    ),",
                "    MissingFamilyCount = Table.RowCount(Table.SelectRows(ExpandFamily, each [source_family_name] = null)),",
                "    ValidFamily = if MissingFamilyCount <> 0 then error Error.Record(",
                "        \"PBI_R3_UNMAPPED_ACQUISITION_SOURCE_FAMILY\",",
                "        \"Accepted acquisition source family does not map to msbf_ref.acquisition_source_family.\",",
                "        [UnmappedRows = MissingFamilyCount]",
                "    ) else ExpandFamily,",
                "    Rename = Table.RenameColumns(ValidFamily, {",
                "        {\"acquisition_source_code\", \"primary_source_code\"},",
                "        {\"acquisition_source_name\", \"source_name\"},",
                "        {\"normalized_source_family\", \"source_family_code\"}",
                "    }),",
                "    AddVersion = Table.AddColumn(Rename, \"mapping_definition_version\", each \"M1_16_ACCEPTED_SOURCE_PROFILE_R3\", type text),",
                "    Select = Table.SelectColumns(AddVersion, {",
                "        \"module1_run_id\", \"primary_source_code\", \"source_name\", \"source_family_code\",",
                "        \"source_family_name\", \"source_family_description\", \"source_subtype\", \"source_classification\",",
                "        \"accepted_partner_channel_id\", \"accepted_channel_type\", \"source_owner_classification\",",
                "        \"vendor_partner_code\", \"third_party_flag\", \"approved_source_flag\", \"governance_status\",",
                "        \"default_attribution_priority\", \"effective_start_date\", \"effective_end_date\",",
                "        \"source_evidence_status\", \"row_hash\", \"mapping_definition_version\"",
                "    })",
                "in",
                "    Select"
              ],
              "type": "m"
            }
          }
        ]
      },
      {
