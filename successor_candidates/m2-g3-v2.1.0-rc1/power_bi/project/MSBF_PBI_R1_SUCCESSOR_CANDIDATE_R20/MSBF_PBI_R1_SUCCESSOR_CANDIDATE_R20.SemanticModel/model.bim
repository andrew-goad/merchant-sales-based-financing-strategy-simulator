        "partitions": [
          {
            "name": "FactValidationResult",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    PK = fxReadBuildCsv(\"validation/PRIMARY_KEY_VALIDATION_RESULTS.csv\"),",
                "    PKKeep = Table.SelectColumns(PK, {\"control_id\",\"schema\",\"object\",\"key_columns\",\"status\",\"residual_limitation\"}),",
                "    PKAddCategory = Table.AddColumn(PKKeep, \"validation_category\", each \"PRIMARY_KEY\", type text),",
                "    PKRename = Table.RenameColumns(PKAddCategory, {{\"schema\",\"source_schema\"},{\"object\",\"source_object\"},{\"key_columns\",\"tested_columns\"}}),",
                "    Rel = fxReadBuildCsv(\"validation/RELATIONSHIP_ORPHAN_VALIDATION_RESULTS.csv\"),",
                "    RelKeep = Table.SelectColumns(Rel, {\"control_id\",\"child_table\",\"child_columns\",\"parent_table\",\"parent_columns\",\"status\",\"note\"}),",
                "    RelAddCategory = Table.AddColumn(RelKeep, \"validation_category\", each \"SOURCE_RELATIONSHIP_ORPHAN\", type text),",
                "    RelAddSchema = Table.AddColumn(RelAddCategory, \"source_schema\", each null, type nullable text),",
                "    RelAddObject = Table.AddColumn(RelAddSchema, \"source_object\", each [child_table] & \" -> \" & [parent_table], type text),",
                "    RelAddColumns = Table.AddColumn(RelAddObject, \"tested_columns\", each [child_columns] & \" -> \" & [parent_columns], type text),",
                "    RelAddLimitation = Table.AddColumn(RelAddColumns, \"residual_limitation\", each [note], type text),",
                "    RelNorm = Table.SelectColumns(RelAddLimitation, Table.ColumnNames(PKRename)),",
                "    Combined = Table.Combine({PKRename, RelNorm}),",
                "    Typed = Table.TransformColumnTypes(Combined, {{\"control_id\",type text},{\"status\",type text},{\"validation_category\",type text},{\"source_schema\",type text},{\"source_object\",type text},{\"tested_columns\",type text},{\"residual_limitation\",type text}}, \"en-US\"),",
                "    AddKey = Table.AddColumn(Typed, \"ValidationControlKey\", each [validation_category] & \"|\" & [control_id], type text)",
                "in AddKey"
              ],
              "type": "m"
            }
          }
        ]
      },
