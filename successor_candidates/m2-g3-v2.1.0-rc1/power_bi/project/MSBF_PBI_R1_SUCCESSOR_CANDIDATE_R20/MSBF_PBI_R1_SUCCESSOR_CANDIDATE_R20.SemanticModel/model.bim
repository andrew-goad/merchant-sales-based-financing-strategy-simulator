              "        REMOVEFILTERS ( 'DimAsOfDate' ),",
              "        'DimAsOfDate'[IsDefaultAsOf] = TRUE ()",
              "    )",
              "RETURN",
              "    IF (",
              "        NOT ISFILTERED ( 'DimAsOfDate'[AsOfDate] ),",
              "        DefaultDate,",
              "        SELECTEDVALUE ( 'DimAsOfDate'[AsOfDate] )",
              "    )"
            ],
            "formatString": "yyyy-mm-dd",
