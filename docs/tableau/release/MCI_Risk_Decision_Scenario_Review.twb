            <run fontcolor='#000000' fontsize='13'>—</run>
            <run bold='true' fontsize='14'>Æ </run>
            <run fontcolor='#555555' fontsize='10'>Dynamic narrative · Updates with portfolio filters</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='MCI - Matched Scenario Review' name='federated.0fsruco0meodj1155retz1yxbwh2' />
          </datasources>
          <datasource-dependencies datasource='federated.0fsruco0meodj1155retz1yxbwh2'>
            <column datatype='string' name='[Acquisition Source]' role='dimension' type='nominal' />
            <column datatype='integer' name='[Baseline Authorized Flag]' role='measure' type='quantitative' />
            <column caption='Narrative - Executive Readout' datatype='string' name='[Calculation_0434088439894021]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF COUNTD([Pair Key]) = 0 THEN&#13;&#10;    &quot;No matched applications in this selection. Clear a filter to continue.&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Across the selected portfolio of &quot;&#13;&#10;    + STR(COUNTD([Pair Key]))&#13;&#10;    + &quot; matched applications, &quot;&#13;&#10;    + STR(INT(SUM([Decision Changed Flag])))&#13;&#10;    + &quot; (&quot;&#13;&#10;    + STR(&#13;&#10;        ROUND(&#13;&#10;            100.0 * SUM([Decision Changed Flag])&#13;&#10;            / COUNTD([Pair Key]),&#13;&#10;            1&#13;&#10;        )&#13;&#10;      )&#13;&#10;    + &quot;%) have different final decision categories. Authorized: &quot;&#13;&#10;    + STR(INT(SUM([Baseline Authorized Flag])))&#13;&#10;    + &quot; in Baseline versus &quot;&#13;&#10;    + STR(INT(SUM([Stress Authorized Flag])))&#13;&#10;    + &quot; in Recession Energy. &quot;&#13;&#10;    + &quot;These are alternative scenarios, not before/after account history.&quot;&#13;&#10;END' />
            </column>
            <column datatype='integer' name='[Decision Changed Flag]' role='measure' type='quantitative' />
            <column datatype='string' name='[Industry]' role='dimension' type='nominal' />
            <column datatype='string' name='[Pair Key]' role='dimension' type='nominal' />
            <column datatype='integer' name='[Stress Authorized Flag]' role='measure' type='quantitative' />
            <column-instance column='[Acquisition Source]' derivation='None' name='[none:Acquisition Source:nk]' pivot='key' type='nominal' />
            <column-instance column='[Industry]' derivation='None' name='[none:Industry:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_0434088439894021]' derivation='User' name='[usr:Calculation_0434088439894021:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0fsruco0meodj1155retz1yxbwh2].[none:Acquisition Source:nk]' filter-group='4'>
            <groupfilter function='level-members' level='[none:Acquisition Source:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.0fsruco0meodj1155retz1yxbwh2].[none:Industry:nk]' filter-group='3'>
            <groupfilter function='level-members' level='[none:Industry:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
