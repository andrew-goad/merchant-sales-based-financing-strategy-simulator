    <worksheet name='05 - Selection Narrative'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='13'>05 / MERCHANT EVIDENCE &amp; DECISION INTERPRETATION </run>
            <run fontcolor='#000000' fontsize='13'>—</run>
            <run bold='true' fontsize='14'>Æ </run>
            <run fontcolor='#555555' fontsize='10'>Source-backed, data-driven explanation of the selected application · Narrative detail filter adjusts interpretation focus</run>
          </formatted-text>
        </title>
      </layout-options>
