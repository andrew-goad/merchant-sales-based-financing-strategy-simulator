              <calculation class='tableau' formula='CASE [Parameters].[Parameter 0434088466272271]&#13;&#10;    WHEN &quot;Industry&quot; THEN [Industry]&#13;&#10;    WHEN &quot;Acquisition Source&quot; THEN [Acquisition Source]&#13;&#10;END' />
