      <column caption='Matched Applications' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_0434088434679808]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Pair Key])' />
      </column>
      <column caption='Different Decisions' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_0434088437313537]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Decision Changed Flag])' />
      </column>
      <column caption='Baseline Authorizations' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_0434088437387266]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Baseline Authorized Flag])' />
      </column>
      <column caption='Stress Authorizations' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_0434088437452803]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Stress Authorized Flag])' />
      </column>
      <column caption='Different Decision Rate' datatype='real' default-format='p0.0%' name='[Calculation_0434088437518340]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_0434088434679808] &gt; 0 THEN&#13;&#10;    [Calculation_0434088437313537] / [Calculation_0434088434679808]&#13;&#10;END' />
      </column>
      <column caption='Narrative - Executive Readout' datatype='string' name='[Calculation_0434088439894021]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF COUNTD([Pair Key]) = 0 THEN&#13;&#10;    &quot;No matched applications in this selection. Clear a filter to continue.&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Across the selected portfolio of &quot;&#13;&#10;    + STR(COUNTD([Pair Key]))&#13;&#10;    + &quot; matched applications, &quot;&#13;&#10;    + STR(INT(SUM([Decision Changed Flag])))&#13;&#10;    + &quot; (&quot;&#13;&#10;    + STR(&#13;&#10;        ROUND(&#13;&#10;            100.0 * SUM([Decision Changed Flag])&#13;&#10;            / COUNTD([Pair Key]),&#13;&#10;            1&#13;&#10;        )&#13;&#10;      )&#13;&#10;    + &quot;%) have different final decision categories. Authorized: &quot;&#13;&#10;    + STR(INT(SUM([Baseline Authorized Flag])))&#13;&#10;    + &quot; in Baseline versus &quot;&#13;&#10;    + STR(INT(SUM([Stress Authorized Flag])))&#13;&#10;    + &quot; in Recession Energy. &quot;&#13;&#10;    + &quot;These are alternative scenarios, not before/after account history.&quot;&#13;&#10;END' />
      </column>
      <column caption='Narrative - Selected Applications' datatype='string' name='[Calculation_0434088445206536]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF COUNTD([Pair Key]) = 0 THEN&#13;&#10;    &quot;No applications match the current selection. Clear the application selection or change the filters.&quot;&#13;&#10;&#13;&#10;ELSEIF COUNTD([Pair Key]) = 1 THEN&#13;&#10;    &quot;Application: &quot;&#13;&#10;    + MIN([Application ID])&#13;&#10;    + CHAR(10) + CHAR(10)&#13;&#10;    + IFNULL(&#13;&#10;        MIN([Comparison Narrative]),&#13;&#10;        &quot;The comparison narrative is unavailable in this source.&quot;&#13;&#10;      )&#13;&#10;&#13;&#10;ELSE&#13;&#10;    STR(COUNTD([Pair Key]))&#13;&#10;    + &quot; applications are in the current investigation selection. &quot;&#13;&#10;    + STR(INT(SUM([Decision Changed Flag])))&#13;&#10;    + &quot; have different final decision categories across the two scenarios. &quot;&#13;&#10;    + &quot;Select one application in the table to inspect its evidence and decision reasons.&quot;&#13;&#10;END' />
      </column>
      <column caption='Narrative - Baseline Story' datatype='string' name='[Calculation_0434088445296649]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF COUNTD([Pair Key]) = 0 THEN&#13;&#10;    &quot;No application matches the current selection.&quot;&#13;&#10;&#13;&#10;ELSEIF COUNTD([Pair Key]) &gt; 1 THEN&#13;&#10;    &quot;Select one application to read its Baseline explanation.&quot;&#13;&#10;&#13;&#10;ELSE&#13;&#10;    IFNULL(&#13;&#10;        CASE [Parameters].[Parameter 0434088444624903]&#13;&#10;            WHEN &quot;Decision&quot; THEN&#13;&#10;                MIN([Baseline Decision Narrative])&#13;&#10;&#13;&#10;            WHEN &quot;Evidence&quot; THEN&#13;&#10;                MIN([Baseline Evidence Narrative])&#13;&#10;&#13;&#10;            WHEN &quot;Structure&quot; THEN&#13;&#10;                MIN([Baseline Structure Narrative])&#13;&#10;&#13;&#10;            WHEN &quot;Source rationale&quot; THEN&#13;&#10;                &quot;Technical source decision rationale; this may describe the independent scenario evaluation before final governance. &quot;&#13;&#10;                + MIN([Baseline Source Decision Why])&#13;&#10;        END,&#13;&#10;        &quot;The selected narrative is unavailable in this source.&quot;&#13;&#10;    )&#13;&#10;END' />
      </column>
      <column caption='Narrative - Stress Story' datatype='string' name='[Calculation_0434088445358090]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF COUNTD([Pair Key]) = 0 THEN&#13;&#10;    &quot;No application matches the current selection.&quot;&#13;&#10;&#13;&#10;ELSEIF COUNTD([Pair Key]) &gt; 1 THEN&#13;&#10;    &quot;Select one application to read its Recession Energy explanation.&quot;&#13;&#10;&#13;&#10;ELSE&#13;&#10;    IFNULL(&#13;&#10;        CASE [Parameters].[Parameter 0434088444624903]&#13;&#10;            WHEN &quot;Decision&quot; THEN&#13;&#10;                MIN([Stress Decision Narrative])&#13;&#10;&#13;&#10;            WHEN &quot;Evidence&quot; THEN&#13;&#10;                MIN([Stress Evidence Narrative])&#13;&#10;&#13;&#10;            WHEN &quot;Structure&quot; THEN&#13;&#10;                MIN([Stress Structure Narrative])&#13;&#10;&#13;&#10;            WHEN &quot;Source rationale&quot; THEN&#13;&#10;                &quot;Technical source decision rationale; this may describe the independent scenario evaluation before final governance. &quot;&#13;&#10;                + MIN([Stress Source Decision Why])&#13;&#10;        END,&#13;&#10;        &quot;The selected narrative is unavailable in this source.&quot;&#13;&#10;    )&#13;&#10;END' />
      </column>
      <column caption='Narrative - Investigation Header' datatype='string' name='[Calculation_0434088457400331]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF COUNTD([Pair Key]) = 0 THEN&#13;&#10;    &quot;No applications match the investigation selection. Clear the application selection or change the filters.&quot;&#13;&#10;&#13;&#10;ELSEIF COUNTD([Pair Key]) = 1 THEN&#13;&#10;    &quot;Merchant &quot;&#13;&#10;    + MIN([Merchant])&#13;&#10;    + &quot; | &quot;&#13;&#10;    + MIN([Industry])&#13;&#10;    + &quot; | &quot;&#13;&#10;    + MIN([Acquisition Source])&#13;&#10;    + CHAR(10)&#13;&#10;    + &quot;Baseline: &quot;&#13;&#10;    + MIN([Baseline Decision])&#13;&#10;    + &quot; | Recession Energy: &quot;&#13;&#10;    + MIN([Stress Decision])&#13;&#10;&#13;&#10;ELSE&#13;&#10;    STR(COUNTD([Pair Key]))&#13;&#10;    + &quot; applications in the current investigation; &quot;&#13;&#10;    + STR(INT(SUM([Decision Changed Flag])))&#13;&#10;    + &quot; have different final decision categories.&quot;&#13;&#10;    + CHAR(10)&#13;&#10;    + &quot;Select one requested-amount value in the table to read both scenario explanations.&quot;&#13;&#10;END' />
      </column>
      <column caption='Baseline Authorization Rate' datatype='real' default-format='p0.0%' name='[Calculation_0434088465809420]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_0434088434679808] &gt; 0 THEN&#13;&#10;    [Calculation_0434088437387266] / [Calculation_0434088434679808]&#13;&#10;END' />
      </column>
      <column caption='Stress Authorization Rate' datatype='real' default-format='p0.0%' name='[Calculation_0434088465920013]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_0434088434679808] &gt; 0 THEN&#13;&#10;    [Calculation_0434088437452803] / [Calculation_0434088434679808]&#13;&#10;END' />
      </column>
      <column caption='Review Segment' datatype='string' name='[Calculation_0434088466939920]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 0434088466272271]&#13;&#10;    WHEN &quot;Industry&quot; THEN [Industry]&#13;&#10;    WHEN &quot;Acquisition Source&quot; THEN [Acquisition Source]&#13;&#10;END' />
      </column>
      <column caption='Decision Pairing Status' datatype='string' name='[Calculation_0434088482525203]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Baseline Decision Code])&#13;&#10;    OR ISNULL([Stress Decision Code]) THEN&#13;&#10;&#13;&#10;    &quot;Decision code unavailable&quot;&#13;&#10;&#13;&#10;ELSEIF [Baseline Decision Code] = [Stress Decision Code] THEN&#13;&#10;&#13;&#10;    &quot;Same final decision category&quot;&#13;&#10;&#13;&#10;ELSE&#13;&#10;&#13;&#10;    &quot;Different final decision category&quot;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Selected Pairing Flag' datatype='integer' name='[Calculation_0434088641122330]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 0434088640520213] = &quot;ALL&quot;&#13;&#10;   OR [Parameters].[Parameter 0434088640671767] = &quot;ALL&quot; THEN&#13;&#10;    0&#13;&#10;ELSEIF [Baseline Decision Code] = [Parameters].[Parameter 0434088640520213]&#13;&#10;   AND [Stress Decision Code] = [Parameters].[Parameter 0434088640671767] THEN&#13;&#10;    1&#13;&#10;ELSE&#13;&#10;    0&#13;&#10;END' />
      </column>
      <column caption='Selected Pairing Applications' datatype='integer' name='[Calculation_0434088641241115]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_0434088641122330])' />
      </column>
      <column caption='Segment Applications' datatype='integer' name='[Calculation_0434088641323036]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Pair Key])' />
      </column>
      <column caption='Selected Pairing Incidence' datatype='real' default-format='p0.0%' name='[Calculation_0434088641380381]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_0434088641323036] &gt; 0 THEN&#13;&#10;    [Calculation_0434088641241115] / [Calculation_0434088641323036]&#13;&#10;END' />
      </column>
