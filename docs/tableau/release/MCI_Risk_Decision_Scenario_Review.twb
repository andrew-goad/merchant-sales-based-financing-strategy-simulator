    <worksheet name='08 - Segment Comparison'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='13'>03 / SEGMENT SENSITIVITY </run>
            <run fontcolor='#000000' fontsize='13'>—</run>
            <run bold='true' fontsize='13'>Æ </run>
            <run fontcolor='#555555' fontsize='10'>Compare authorization rates or investigate selected decision pairings</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='MCI - Matched Scenario Review' name='federated.0fsruco0meodj1155retz1yxbwh2' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Review Segment By' datatype='string' name='[Parameter 0434088466272271]' param-domain-type='list' role='measure' type='nominal' value='&quot;Industry&quot;'>
              <calculation class='tableau' formula='&quot;Industry&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0fsruco0meodj1155retz1yxbwh2'>
            <column datatype='string' name='[Acquisition Source]' role='dimension' type='nominal' />
            <column datatype='integer' name='[Baseline Authorized Flag]' role='measure' type='quantitative' />
            <column caption='Matched Applications' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_0434088434679808]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Pair Key])' />
            </column>
            <column caption='Baseline Authorizations' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_0434088437387266]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Baseline Authorized Flag])' />
            </column>
            <column caption='Stress Authorizations' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_0434088437452803]' role='measure' type='quantitative'>
